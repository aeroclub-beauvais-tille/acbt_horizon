---
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
// Polices hébergées sur le site (plus rapide et sans appel à Google) ; les deux fichiers utiles sont chargés en priorité.
import policeTitre from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import policeTexte from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url, asset } from '../lib/utils';

interface Props { title: string; description?: string; noindex?: boolean; univers?: string; image?: string; type?: 'website' | 'article' }
const { title, description = "Aéroclub de Beauvais-Tillé : baptêmes de l'air, formation de pilote BIA, LAPL et PPL dans l'Oise depuis 1979.", noindex = false, univers, image, type = 'website' } = Astro.props;
const fullTitle = title === 'Accueil' ? "Aéroclub de Beauvais-Tillé (ACBT)" : `${title} · Aéroclub de Beauvais-Tillé`;
// Adresse officielle de la page et image affichée quand on partage un lien (Facebook, WhatsApp…)
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const partage = new URL(asset(image || '/partage.jpg'), Astro.site).href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={url('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preload" href={policeTitre} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={policeTexte} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f5f8fc" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Aéroclub de Beauvais-Tillé" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={partage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <!-- Animations : activées seulement si JavaScript tourne et que la personne n'a pas demandé à les réduire.
         Filet de sécurité : si le moteur ne démarre pas en 4 s, tout redevient visible. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(() => { if (!document.documentElement.classList.contains('motion-ready')) document.documentElement.classList.remove('motion'); }, 4000);
      }
    </script>
  </head>
  <body data-univers={univers}>
    <Header><slot name="entete" slot="actions" /></Header>
    <main><slot /></main>
    <script is:inline>
      // Signature typographique d'Horizon : la fin de chaque grand titre en italique (comme sur l'accueil).
      // Ne touche pas aux titres qui ont déjà leur italique ni à l'espace membre.
      if (document.body.dataset.univers !== 'membres') document.querySelectorAll('main h1, main h2').forEach(function (h) {
        if (h.querySelector('*') || h.closest('[data-sans-italique]')) return;
        var m = h.textContent.trim().split(/\s+/);
        if (m.length < 2) return;
        var n = /^[?!:;.»]+$/.test(m[m.length - 1]) || m[m.length - 1].length <= 2 ? 2 : 1;
        if (m.length - n < 1) return;
        h.textContent = m.slice(0, -n).join(' ') + ' ';
        var em = document.createElement('em'); em.textContent = m.slice(-n).join(' '); h.appendChild(em);
      });
    </script>
    <Footer />
    <script>import '../scripts/motion';</script>
  </body>
</html>
