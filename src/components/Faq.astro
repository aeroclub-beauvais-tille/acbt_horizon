---
// Questions fréquentes en accordéon, avec les données structurées pour les moteurs de recherche.
interface Props { questions: { question: string; reponse: string }[] }
const { questions } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: questions.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.reponse } })) };
---
<div class="faq" data-stagger>
  {questions.map((q) => (
    <details>
      <summary>{q.question}<span aria-hidden="true">+</span></summary>
      <p>{q.reponse}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<style>
  /* Questions en filets : pas de boîte, un grand + fin qui pivote */
  .faq { max-width: 900px; margin-top: clamp(28px, 4vw, 48px); border-top: 1px solid var(--ink); }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 0; font-family: var(--font-title); font-weight: 400; font-size: clamp(1.1rem, 2vw, 1.4rem); letter-spacing: -.02em; color: var(--ink); transition: color .2s; }
  summary:hover { color: var(--accent-fonce); }
  summary::-webkit-details-marker { display: none; }
  summary span { flex: none; font-family: var(--font-title); font-weight: 200; font-size: 2rem; line-height: 1; color: var(--accent); transition: transform .3s cubic-bezier(.2,.7,.2,1); }
  details[open] summary span { transform: rotate(45deg); }
  p { margin: 0; padding: 0 48px 24px 0; color: var(--muted); max-width: 68ch; }
</style>
