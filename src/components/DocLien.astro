---
import { asset } from '../lib/utils';
import { titreDoc, etatValidite } from '../lib/documents';
interface Props {
  doc: { id?: string; titre?: string; type?: string; avions?: string[]; fichier?: string; lien?: string; description?: string; mis_a_jour?: Date; debut?: Date; fin?: Date };
  court?: string;
  badge?: boolean;      // force l'affichage d'un badge de validité
  sansBadge?: boolean;  // n'affiche jamais de badge (ex. documents du club, toujours valables)
  vers?: string;        // onglet cible de l'alerte d'expiration
  manquant?: boolean;   // document exigé mais pas encore mis en ligne
  ligne?: boolean;      // ligne compacte : bord coloré + date seule (documents nécessaires au vol)
}
const { doc, court, badge, sansBadge, vers, manquant, ligne } = Astro.props;
const titre = titreDoc(doc);
const cible = doc.fichier ? asset(doc.fichier) : doc.lien || '';
const ext = (doc.fichier || '').split('?')[0].split('.').pop()?.toLowerCase() || '';
const kind = doc.fichier
  ? (['xls', 'xlsx', 'ods', 'csv'].includes(ext) ? 'XLS' : ['doc', 'docx', 'odt'].includes(ext) ? 'DOC' : ['mp4', 'mov', 'webm'].includes(ext) ? 'VIDÉO' : 'PDF')
  : /youtu|vimeo/.test(doc.lien || '') ? 'VIDÉO' : 'LIEN';
const recherche = `${titre} ${doc.type ?? ''} ${doc.description ?? ''}`.toLowerCase();

const avecBadge = !manquant && !sansBadge && (badge || !!(doc.debut || doc.fin || doc.type));
const e = avecBadge ? etatValidite(doc) : null;
const court2 = (d?: Date) => d ? d.toLocaleDateString('fr-FR', { timeZone: 'Europe/Paris', day: '2-digit', month: '2-digit', year: '2-digit' }) : '';
// Repli calculé au build ; le navigateur le remet à jour (reste juste même hors ligne).
const chip = !e ? '' : e.code === 'sans-fin' ? 'Valide' : e.code === 'a-venir' ? 'À venir'
  : e.code === 'expire' ? 'Expiré' : e.code === 'bientot' ? `${e.jours} j` : 'Valide';
const ech = !e ? '' : e.code === 'sans-fin' ? 'n’expire pas' : e.code === 'a-venir' ? `dès le ${court2(doc.debut)}`
  : e.code === 'expire' ? `le ${court2(doc.fin)}` : `jusqu’au ${court2(doc.fin)}`;
const iso = (d?: Date) => d ? d.toISOString() : undefined;
const noFichier = !cible;
// Ligne compacte : seule la date est écrite (fin, ou début si pas encore en vigueur) ; la couleur dit l'état
const dateSeule = !e ? '' : e.code === 'a-venir' ? court2(doc.debut) : court2(doc.fin);
const etat = manquant ? 'na' : e?.code === 'sans-fin' ? 'valide' : e?.code;
---
{ligne ? (
<a class:list={['doc', 'ligne', { vide: noFichier, manquant }]} href={cible || undefined} target={cible ? '_blank' : undefined} rel="noopener" data-q={recherche} data-doc={doc.id} data-etat={etat} role={noFichier ? 'group' : undefined}>
  <strong>{court ?? titre}</strong>
  {avecBadge && <span class="badge" data-format="date" data-code={e?.code} data-fin={iso(doc.fin)} data-debut={iso(doc.debut)} data-titre={titre} data-vers={vers}>{dateSeule}</span>}
</a>
) : (
<a class:list={['doc', { vide: noFichier, manquant }]} href={cible || undefined} target={cible ? '_blank' : undefined} rel="noopener" data-q={recherche} data-doc={doc.id} role={noFichier ? 'group' : undefined}>
  <span class:list={['type', `t-${kind.toLowerCase().replace('é', 'e')}`, { attente: noFichier }]}>{noFichier ? '—' : kind}</span>
  <span class="txt">
    <strong>{court ?? titre}</strong>
    {avecBadge ? (
      <span class="valid">
        <span class="badge" data-code={e?.code} data-fin={iso(doc.fin)} data-debut={iso(doc.debut)} data-titre={titre} data-vers={vers}>{chip}</span>
        <span class="ech">{ech}</span>
      </span>
    ) : (doc.description && <span class="meta">{doc.description}</span>)}
    {manquant ? <span class="valid"><span class="manque">Non disponible</span></span>
      : noFichier && !avecBadge && <span class="meta">Pas encore déposé</span>}
  </span>
</a>
)}
<style>
  .doc { display: flex; gap: 11px; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 11px 13px; text-decoration: none; color: inherit; transition: border-color .15s, transform .12s, box-shadow .15s; }
  a.doc[href]:active { transform: scale(.99); }
  a.doc[href]:hover { border-color: var(--accent); box-shadow: 0 2px 10px rgba(11,92,255,.08); }
  .doc.vide { border-style: dashed; background: var(--surface-2); }
  .doc strong { font-weight: 650; font-size: .95rem; line-height: 1.25; display: block; }
  .doc .meta { display: block; font-size: .8rem; color: var(--muted); margin-top: 2px; }
  .txt { min-width: 0; flex: 1; }
  .type { flex: none; min-width: 42px; text-align: center; font-weight: 700; font-size: .62rem; letter-spacing: .03em; padding: 7px 5px; border-radius: 8px; background: var(--surface-2); color: var(--muted); }
  .type.attente { background: transparent; border: 1px dashed var(--line); color: var(--muted); }
  .t-pdf { background: #fce9e7; color: #c0392b; }
  .t-xls { background: #e4f4ea; color: #1e7e34; }
  .t-doc { background: #e6eefc; color: #2f6fd6; }
  .t-video { background: #f0e8ff; color: #6b4fbb; }
  .t-lien { background: var(--accent-soft); color: var(--accent); }
  /* Badge compact : pastille courte (sans retour à la ligne) + échéance en texte discret */
  .valid { display: flex; align-items: center; gap: 8px; margin-top: 5px; flex-wrap: wrap; }
  .badge { flex: none; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px; font-size: .74rem; font-weight: 700; padding: 2px 9px; border-radius: 999px; border: 1px solid; }
  .badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .badge[data-code='valide'], .badge[data-code='sans-fin'] { color: var(--ok); background: var(--ok-bg); border-color: var(--ok-line); }
  .badge[data-code='bientot'] { color: var(--warn); background: var(--warn-bg); border-color: var(--warn-line); }
  .badge[data-code='expire'] { color: var(--bad); background: var(--bad-bg); border-color: var(--bad-line); }
  .badge[data-code='a-venir'] { color: var(--muted); background: var(--surface-2); border-color: var(--line); }
  .manque { flex: none; white-space: nowrap; display: inline-flex; align-items: center; font-size: .74rem; font-weight: 700; padding: 2px 9px; border-radius: 999px; border: 1px dashed var(--line); color: var(--muted); }
  .doc.manquant { padding: 9px 13px; }
  .doc.manquant .type { display: none; }
  .doc.manquant .txt { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .doc.manquant strong { font-weight: 600; color: var(--muted); }
  .doc.manquant .valid { margin-top: 0; }
  /* Ligne compacte (style C) : bord gauche coloré, date à droite, fond teinté si orange/rouge */
  .doc.ligne { border: 0; border-left: 5px solid var(--ok); border-radius: 0; padding: 12px 14px 12px 12px; gap: 10px; background: var(--surface); }
  a.doc.ligne[href]:hover { box-shadow: none; background: var(--surface-2); }
  .doc.ligne strong { flex: 1; min-width: 0; font-weight: 700; font-size: .9rem; }
  .doc.ligne .badge { border: 0; background: none; padding: 0; color: var(--ink); font-size: .82rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .doc.ligne .badge::before { display: none; }
  .doc.ligne[data-etat='bientot'] { border-left-color: var(--warn); background: var(--warn-bg); }
  .doc.ligne[data-etat='bientot'] .badge { color: var(--warn); }
  .doc.ligne[data-etat='expire'] { border-left-color: var(--bad); background: var(--bad-bg); }
  .doc.ligne[data-etat='expire'] .badge { color: var(--bad); }
  .doc.ligne[data-etat='a-venir'] { border-left-color: var(--line); }
  .doc.ligne[data-etat='a-venir'] .badge { color: var(--muted); }
  .doc.ligne.manquant { border-left-color: var(--line); background: var(--surface-2); border-style: solid; }
  .doc.ligne.manquant strong { color: var(--muted); font-weight: 600; }
  .ech { font-size: .78rem; color: var(--muted); white-space: nowrap; }
</style>
