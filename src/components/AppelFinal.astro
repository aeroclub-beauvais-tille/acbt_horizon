---
// Bloc de fin de page sur fond nuit : une phrase, deux boutons. Évite qu'une page se termine sur une FAQ.
interface Props { titre: string; texte?: string; boutons: { label: string; href: string; principal?: boolean }[]; eyebrow?: string }
const { titre, texte, boutons, eyebrow } = Astro.props;
---
<section class="section dark appel">
  <div class="container appel-in">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2 data-split>{titre}</h2>
    {texte && <p class="appel-txt" data-reveal>{texte}</p>}
    <div class="appel-btns" data-reveal>
      {boutons.map((b) => <a class:list={['btn', b.principal ? 'btn-primary' : 'btn-outline']} href={b.href}>{b.label}</a>)}
    </div>
  </div>
</section>
<style>
  .appel { position: relative; overflow: hidden; }
  .appel::before { content: ''; position: absolute; inset: auto -10% -60% auto; width: 70vw; height: 70vw; border-radius: 50%; background: radial-gradient(closest-side, rgba(66,124,214,.28), transparent); pointer-events: none; }
  .appel-in { position: relative; text-align: center; }
  .appel .eyebrow { justify-content: center; }
  .appel .eyebrow::after { display: none; }
  .appel h2 { margin: 0 auto 18px; max-width: 18ch; font-size: clamp(2.4rem, 5.4vw, 4.6rem); }
  .appel-txt { margin: 0 auto 32px; max-width: 52ch; font-size: 1.12rem; color: #b9c6da; }
  .appel-btns { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
</style>
