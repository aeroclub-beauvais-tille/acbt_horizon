---
// Pied de page compact : trois lignes sur téléphone (club, contact, mentions).
import club from '../data/club.json';
import { url } from '../lib/utils';
const liens = [
  { label: "Baptême de l'air", href: '/decouvrir-le-vol' },
  { label: 'Devenir pilote', href: '/formations' },
  { label: 'Tarifs', href: '/club/tarifs' },
  { label: 'La flotte', href: '/club/flotte' },
  { label: 'Actualités', href: '/actualites' },
  { label: 'Espace membre', href: '/membre' },
];
---
<footer class="site-footer">
  <div class="haut">
    <a class="ident" href={url('/')}>
      <img src={url('/uploads/logo/logo-acbt.png')} alt="" width="40" height="29" loading="lazy" />
      <span><strong>ACBT</strong><small>{club.adresse}</small></span>
    </a>
    <nav class="liens" aria-label="Plan du site">{liens.map((l) => <a href={url(l.href)}>{l.label}</a>)}</nav>
    <div class="joindre">
      <a href={`tel:${club.telephone.replace(/\s/g, '')}`}>{club.telephone}</a>
      <a href={`mailto:${club.email}`}>{club.email}</a>
    </div>
  </div>
  <div class="legal">
    <span>© {new Date().getFullYear()} {club.sigle || 'ACBT'} · association loi 1901 depuis 1979{club.partenaires.length > 0 && <span class="partenaires"> · Avec {club.partenaires.map((p, i) => <>{i > 0 && ', '}<a href={p.lien} rel="noopener">{p.nom}</a></>)}</span>}</span>
    <nav aria-label="Informations légales">
      <a href={club.facebook} rel="noopener">Facebook</a>
      <a href={url('/mentions-legales')}>Mentions légales</a>
    </nav>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); padding: 26px clamp(20px, 4vw, 56px) 20px; font-size: .9rem; background: var(--paper); }
  a { color: var(--ink); text-decoration: none; }
  a:hover { color: var(--accent-fonce); }
  .haut { display: grid; grid-template-columns: auto 1fr auto; gap: 14px 40px; align-items: center; }
  .ident { display: flex; align-items: center; gap: 12px; }
  .ident img { width: 40px; height: auto; background: #fff; border: 1px solid var(--line); border-radius: 6px; padding: 2px; }
  .ident span { display: flex; flex-direction: column; line-height: 1.25; }
  .ident strong { font-family: var(--font-title); font-weight: 600; letter-spacing: .08em; }
  .ident small { color: var(--muted); font-size: .78rem; }
  .liens { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 22px; }
  .liens a { color: var(--muted); }
  .joindre { display: flex; gap: 22px; font-family: var(--font-title); font-weight: 500; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line); font-size: .76rem; color: var(--muted); }
  .legal a { color: var(--muted); }
  .legal nav { display: flex; gap: 16px; }
  @media (max-width: 900px) {
    .haut { grid-template-columns: 1fr; gap: 10px; }
    .liens, .partenaires { display: none; }
    .ident small { display: none; }
    .joindre { justify-content: space-between; flex-wrap: wrap; gap: 4px 16px; }
    .legal { margin-top: 12px; padding-top: 10px; }
  }
</style>
