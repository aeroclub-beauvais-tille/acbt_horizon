---
// Étapes numérotées (déroulement d'un vol, parcours de formation).
// trajectoire : un petit avion vole le long de la route qui relie les étapes (grand écran).
interface Props { etapes: { titre: string; texte: string }[]; trajectoire?: boolean }
const { etapes, trajectoire = false } = Astro.props;
const N = etapes.length;
// Points par lesquels passe la route : au centre de chaque colonne, à une hauteur qui ondule.
const pts = etapes.map((_, i) => {
  const x = ((i + 0.5) / N) * 100;
  const y = 50 + (i % 2 === 0 ? -14 : 14);
  return [x, y] as [number, number];
});
const d = pts
  .map(([x, y], i) => {
    if (i === 0) return `M ${x} ${y}`;
    const [px, py] = pts[i - 1];
    const cx = (px + x) / 2;
    return `C ${cx} ${py} ${cx} ${y} ${x} ${y}`;
  })
  .join(' ');
const [ex, ey] = pts[N - 1];

// Échantillonnage de la courbe pour faire voler l'avion exactement sur le tracé.
const SEG = 10;
const samples: [number, number][] = [];
for (let i = 1; i < N; i++) {
  const [px, py] = pts[i - 1];
  const [x, y] = pts[i];
  const cx = (px + x) / 2;
  for (let s = i === 1 ? 0 : 1; s <= SEG; s++) {
    const t = s / SEG, mt = 1 - t;
    const bx = mt * mt * mt * px + 3 * mt * mt * t * cx + 3 * mt * t * t * cx + t * t * t * x;
    const by = mt * mt * mt * py + 3 * mt * mt * t * py + 3 * mt * t * t * y + t * t * t * y;
    samples.push([bx, by]);
  }
}
const M = samples.length;
const sx = 11, sy = 0.64; // échelle approx. px pour orienter le nez de l'avion
const uid = Math.random().toString(36).slice(2, 8);
const anim = `vole-${uid}`;
const keyframes = samples.map((pt, idx) => {
  const next = samples[Math.min(idx + 1, M - 1)];
  const prev = samples[Math.max(idx - 1, 0)];
  const ang = Math.atan2((next[1] - prev[1]) * sy, (next[0] - prev[0]) * sx) * 180 / Math.PI;
  const rot = (90 + ang).toFixed(1);
  const p = ((idx / (M - 1)) * 100).toFixed(2);
  return `${p}%{left:${pt[0].toFixed(2)}%;top:${pt[1].toFixed(2)}%;transform:translate(-50%,-50%) rotate(${rot}deg)}`;
}).join('');
const planeCss = `@media (min-width:760px){.motion .avion-${uid}{animation:${anim} 3.4s cubic-bezier(.45,.05,.35,1) .35s both}}@keyframes ${anim}{${keyframes}}`;
---
<div class:list={['etapes-zone', { 'a-route': trajectoire }]}>
  {trajectoire && N > 1 && (
    <div class="route-zone" aria-hidden="true">
      <svg class="route" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path class="route-trace" d={d} pathLength="1" />
      </svg>
      <span class={`avion avion-${uid}`} style={`left:${ex}%;top:${ey}%`}>
        <svg viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" /></svg>
      </span>
      <style is:inline set:html={planeCss}></style>
    </div>
  )}
  <ol class="etapes" style={`--n: ${N}`} data-stagger>
    {etapes.map((e, i) => (
      <li>
        <span class="num">{i + 1}</span>
        <h3>{e.titre}</h3>
        <p>{e.texte}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  /* Étapes éditoriales : un filet, un grand numéro net, pas de boîte */
  /* Étapes en cartes teintées : grand numéro bleu, titre net, texte lisible */
  .etapes { list-style: none; margin: clamp(32px, 4vw, 52px) 0 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  li { position: relative; padding: 24px 22px 26px; border-radius: var(--radius); background: var(--paper-2); border-top: 3px solid var(--accent); }
  .num { display: block; font-family: var(--font-title); font-weight: 600; font-size: 3rem; letter-spacing: -.04em; font-variant-numeric: tabular-nums; line-height: 1; color: var(--accent); margin-bottom: 20px; }
  .num::before { content: '0'; }
  h3 { font-size: 1.3rem; font-weight: 500; letter-spacing: -.02em; margin: 0 0 8px; color: var(--ink); }
  p { margin: 0; color: var(--ink-2); font-size: .95rem; max-width: 40ch; }
  @media (max-width: 640px) {
    .etapes { gap: 10px; }
    li { display: grid; grid-template-columns: 56px 1fr; gap: 0 8px; padding: 18px 16px 20px; }
    .num { grid-row: span 2; font-size: 2.2rem; margin: 0; }
  }

  /* Route + avion qui relie les étapes (grand écran seulement) */
  .etapes-zone { position: relative; }
  .a-route .etapes { border-top: 0; }
  .route-zone { display: none; }
  @media (min-width: 760px) {
    .a-route .route-zone { display: block; position: absolute; left: 6%; top: -10px; width: 88%; height: 64px; pointer-events: none; z-index: 2; }
    .route { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .route-trace { fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-dasharray: 2.4 2.4; stroke-linecap: round; vector-effect: non-scaling-stroke; opacity: .5; }
    .avion { position: absolute; width: 22px; height: 22px; transform: translate(-50%, -50%) rotate(90deg); z-index: 3; }
    .avion svg { width: 100%; height: 100%; display: block; fill: var(--accent); filter: drop-shadow(0 1px 1.5px rgba(16, 32, 59, .18)); }
    .motion .route-trace { animation: route-dash 1.6s ease-out .2s both; }
    @keyframes route-dash { from { stroke-dashoffset: 40; opacity: 0; } to { stroke-dashoffset: 0; opacity: .5; } }
  }
</style>
