---
// Étapes numérotées (déroulement d'un vol, parcours de formation).
interface Props { etapes: { titre: string; texte: string }[] }
const { etapes } = Astro.props;
---
<ol class="etapes" style={`--n: ${etapes.length}`} data-stagger>
  {etapes.map((e, i) => (
    <li>
      <span class="num">{i + 1}</span>
      <h3>{e.titre}</h3>
      <p>{e.texte}</p>
    </li>
  ))}
</ol>
<style>
  /* Étapes éditoriales : un filet, un grand numéro en italique, pas de boîte */
  .etapes { list-style: none; margin: clamp(32px, 4vw, 52px) 0 0; padding: 0; display: grid; gap: 0 28px; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); border-top: 1px solid var(--ink); }
  li { position: relative; padding: 22px 0 28px; border-bottom: 1px solid var(--line); }
  .num { display: block; font-family: var(--font-serif); font-style: italic; font-size: 2.6rem; line-height: 1; color: var(--accent); margin-bottom: 18px; }
  .num::before { content: '0'; }
  h3 { font-size: 1.3rem; font-weight: 400; letter-spacing: -.02em; margin: 0 0 8px; }
  p { margin: 0; color: var(--muted); font-size: .95rem; max-width: 40ch; }
  @media (max-width: 640px) {
    li { display: grid; grid-template-columns: 52px 1fr; gap: 0 8px; padding: 18px 0 20px; }
    .num { grid-row: span 2; font-size: 2rem; margin: 0; }
  }
</style>
