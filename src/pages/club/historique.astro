---
import { photo, photoUrl } from '../../lib/photo';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import h from '../../data/historique.json';
import { asset } from '../../lib/utils';
import pages from '../../data/pages.json';
---
<Base univers="club" title="Notre histoire" description="L'histoire de l'aéroclub de Beauvais-Tillé depuis 1979.">
  <PageHead eyebrow="Le club" image={pages.historique.image} title={pages.historique.titre} lead={h.intro} />
  <section class="section">
    <div class="container">
      <ol class="frise">
        {h.etapes.map((e) => (
          <li data-reveal>
            <span class="annee">{e.annee}</span>
            <div class="contenu">
              <h2 data-sans-italique>{e.titre}</h2>
              <p>{e.texte}</p>
              {e.photos.length > 0 && (
                <div class="gallery" data-stagger>{e.photos.map((p) => <a href={asset(p)} target="_blank"><img {...photo(p, '(min-width: 700px) 25vw, 50vw')} alt={`${e.titre}, ${e.annee}`} loading="lazy" /></a>)}</div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
<style>
  /* Frise : de grandes années en italique dans la marge, un filet par époque */
  .frise { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--ink); }
  .frise li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); gap: clamp(20px, 5vw, 80px); padding: clamp(28px, 4vw, 52px) 0; border-bottom: 1px solid var(--line); }
  .annee { font-family: var(--font-serif); font-style: italic; font-size: clamp(3.4rem, 8vw, 7rem); line-height: .9; color: var(--accent); letter-spacing: -.02em; }
  .contenu { max-width: 760px; }
  .contenu h2 { font-size: clamp(1.6rem, 2.8vw, 2.4rem); margin-bottom: .45em; }
  .contenu p { color: var(--muted); }
  .gallery { margin-top: 20px; }
  @media (max-width: 640px) {
    .frise li { grid-template-columns: 1fr; gap: 10px; }
    .annee { font-size: 3.6rem; }
  }
</style>
