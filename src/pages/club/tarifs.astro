---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import HeuresVol from '../../components/HeuresVol.astro';
import { getCollection } from 'astro:content';
import club from '../../data/club.json';
import t from '../../data/tarifs.json';
const avions = (await getCollection('avions', (a) => a.data.actif)).sort((a, b) => a.data.ordre - b.data.ordre);
const ad = t.adhesion;
const n = (x: number) => x.toLocaleString('fr-FR');
const op = t.objectif_pilote;
import pages from '../../data/pages.json';
---
<Base univers="voler" title="Tarifs" description={`Tarifs ${t.annee} de l'aéroclub de Beauvais-Tillé : heures de vol, adhésion, vols découverte.`}>
  <PageHead eyebrow="Tarifs" image={pages.tarifs.image} title={pages.tarifs.titre} lead={pages.tarifs.texte}>
    <nav class="sommaire" aria-label="Sommaire des tarifs">
      <a href="#heures">Heures de vol</a><a href="#adhesion">Adhésion</a><a href="#divers">Divers</a>
    </nav>
  </PageHead>

  <section class="section" id="heures">
    <div class="container">
      <div class="section-head">
        <div><span class="label">Heures de vol</span><h2 data-split>{pages.tarifs.intertitres.heures}</h2></div>
        <p class="lead" style="max-width:42ch;margin:0">En solo une fois lâché, ou en double commande avec un instructeur pendant la formation.</p>
      </div>
      <div data-reveal><HeuresVol avions={avions} /></div>
      <div class="blocs" data-reveal>
        <div class="blocs-titre"><strong>Achetez vos heures par bloc</strong><span>{t.blocs_note}</span></div>
        {t.blocs.map((b) => <div class="bloc"><span class="h">{b.heures} h achetées</span><span class="o">{b.offert}</span></div>)}
      </div>
    </div>
  </section>

  <section class="section white" id="adhesion">
    <div class="container">
      <div class="section-head">
        <div><span class="label">Adhésion {t.annee}</span><h2 data-split>{pages.tarifs.intertitres.adhesion}</h2></div>
        <p class="lead" style="max-width:42ch;margin:0">L'adhésion annuelle comprend la cotisation au club et la licence FFA avec son assurance.</p>
      </div>
      <div class="formules" data-stagger>
        {ad.colonnes.map((c) => (
          <div class:list={['formule', { vedette: c.mise_en_avant }]}>
            {c.mise_en_avant && <span class="ruban">Pour bien démarrer</span>}
            <span class="public">{c.public}</span>
            <h3>{c.titre}</h3>
            <p class="total">{n(c.cotisation_acbt + ad.cotisation_ffa)}<small>€/an</small></p>
            <ul>
              <li><span>Cotisation ACBT</span><b>{n(c.cotisation_acbt)} €</b></li>
              <li><span>Licence et assurance FFA</span><b>{n(ad.cotisation_ffa)} €</b></li>
              <li class="option"><span>Infopilote (facultatif)</span><b>+ {n(ad.infopilote)} €</b></li>
            </ul>
          </div>
        ))}
        <div class="formule temporaire">
          <span class="public">Pour {t.temporaire.duree}</span>
          <h3>{t.temporaire.titre}</h3>
          <p class="total">{n(t.temporaire.prix)}<small>€</small></p>
          <p class="meta">{t.temporaire.texte}</p>
        </div>
      </div>
      <p class="meta" style="margin-top:20px">{ad.note}</p>
      <div class="aides" data-stagger>
        {club.aides.map((a) => <div><strong>{a.titre}</strong><span>{a.texte}</span></div>)}
      </div>
      {op && (
        <div class="objectif" id="objectif-pilote" data-reveal>
          <div class="objectif-intro">
            <span class="public">Moins de 21 ans</span>
            <h3>{op.titre}</h3>
            <p>{op.intro}</p>
            <p class="meta">{op.note}</p>
          </div>
          <details class="aides">
            <summary>Cliquer pour découvrir les aides <span aria-hidden="true">+</span></summary>
            <table class="objectif-table">
              <thead><tr><th scope="col">Étape</th><th scope="col">Aide</th></tr></thead>
              <tbody>{op.lignes.map((l) => <tr><td>{l.etape}</td><td>{n(l.montant)} €</td></tr>)}</tbody>
            </table>
          </details>
        </div>
      )}
    </div>
  </section>

  <section class="section" id="divers">
    <div class="container divers">
      <div><span class="label">Divers</span><h2 data-split>{pages.tarifs.intertitres.divers}</h2><p class="lead">Le matériel du pilote est disponible au club.</p></div>
      <ul class="lignes grandes" data-stagger>{t.divers.map((d) => <li><span>{d.libelle}</span><b>{d.prix}</b></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .sommaire { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .sommaire a { color: #fff; text-decoration: none; font-size: .9rem; padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(255,255,255,.35); backdrop-filter: blur(6px); }
  .sommaire a:hover { background: #fff; color: var(--ink); }

  .blocs { margin-top: 40px; display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 1px; background: var(--nuit); border-radius: var(--radius); overflow: hidden; }
  .blocs > div { background: var(--nuit); color: #fff; padding: 22px 26px; display: flex; flex-direction: column; justify-content: center; }
  .blocs-titre strong { font-family: var(--font-title); font-size: 1.5rem; font-weight: 300; letter-spacing: -.02em; }
  .blocs-titre span { color: #9fb0c8; font-size: .9rem; }
  .bloc { border-left: 1px solid rgba(255,255,255,.12); }
  .bloc .h { font-size: .75rem; text-transform: uppercase; letter-spacing: .12em; color: #9fb0c8; }
  .bloc .o { font-family: var(--font-title); font-weight: 600; font-size: 1.6rem; font-variant-numeric: tabular-nums; color: #86b4e6; }
  @media (max-width: 760px) { .blocs { grid-template-columns: 1fr; } .bloc { border-left: 0; border-top: 1px solid rgba(255,255,255,.12); } }

  .formules { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); align-items: stretch; }
  .formule { position: relative; border: 1px solid var(--line); border-radius: var(--radius); padding: 30px 26px; background: var(--paper); display: flex; flex-direction: column; }
  .formule.vedette { background: var(--nuit); color: #c3cedf; border-color: var(--ink); }
  .formule.vedette h3, .formule.vedette .total { color: #fff; }
  .formule.vedette li { border-color: rgba(255,255,255,.12); }
  .formule.vedette b { color: #fff; }
  .formule.temporaire { background: transparent; border-style: dashed; }
  .ruban { position: absolute; top: -12px; left: 24px; background: var(--accent); color: #fff; font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; }
  .public { font-family: var(--font-title); font-size: .72rem; text-transform: uppercase; letter-spacing: .16em; font-weight: 500; color: var(--muted); }
  .vedette .public { color: #86b4e6; }
  .formule h3 { margin: 8px 0 18px; font-size: 1.5rem; font-weight: 300; }
  .total { font-family: var(--font-title); font-size: clamp(3.2rem, 5vw, 4.4rem); font-weight: 300; letter-spacing: -.05em; color: var(--ink); line-height: 1; margin: 0 0 22px; font-variant-numeric: tabular-nums; }
  .total small { margin-left: 6px; font-family: var(--font-body); font-size: 1rem; font-weight: 500; color: var(--muted); letter-spacing: 0; }
  .formule.vedette .total small { color: #9fb0c8; }
  .formule ul, .lignes { list-style: none; margin: 0; padding: 0; }
  .formule li, .lignes li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-top: 1px solid var(--line); font-size: .93rem; }
  .formule li.option { opacity: .75; }
  .lignes { margin-top: auto; }
  .lignes b { white-space: nowrap; color: var(--ink); }
  .aides { margin-top: 32px; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .aides div { display: flex; flex-direction: column; gap: 6px; padding: 18px 0 0; border-top: 1px solid var(--line); }
  .aides strong { font-family: var(--font-title); font-weight: 400; font-size: 1.15rem; letter-spacing: -.01em; }
  .aides span { font-size: .9rem; color: var(--muted); }

  .objectif { margin-top: 56px; display: grid; gap: 40px; grid-template-columns: 1fr 1.4fr; align-items: start; padding: 32px 0 0; border-top: 1px solid var(--ink); }
  @media (max-width: 800px) { .objectif { grid-template-columns: 1fr; padding: 22px; } }
  .objectif .public { color: var(--accent-fonce); }
  .objectif h3 { font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 300; letter-spacing: -.035em; margin: 8px 0 14px; }
  .aides { width: 100%; align-self: center; }
  .aides summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 20px; border-radius: var(--radius); background: var(--paper); border: 1px solid var(--line); font-weight: 600; }
  .aides summary::-webkit-details-marker { display: none; }
  .aides summary span { font-weight: 200; font-size: 1.8rem; line-height: 1; color: var(--accent); transition: transform .3s; }
  .aides[open] summary { margin-bottom: 18px; }
  .aides[open] summary span { transform: rotate(45deg); }
  .objectif-table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  .objectif-table th { text-align: left; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 600; padding: 0 0 10px; border-bottom: 2px solid var(--ink); }
  .objectif-table td { padding: 11px 0; border-bottom: 1px solid var(--line); }
  .objectif-table th:last-child, .objectif-table td:last-child { text-align: right; white-space: nowrap; font-weight: 600; font-variant-numeric: tabular-nums; padding-left: 16px; }

  .divers { display: grid; gap: 40px; grid-template-columns: 1fr 1.3fr; align-items: start; }
  @media (max-width: 800px) { .divers { grid-template-columns: 1fr; } }
  .grandes li { padding: 16px 0; font-size: 1.02rem; }
</style>
