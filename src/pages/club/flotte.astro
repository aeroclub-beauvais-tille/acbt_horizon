---
import { photo, photoUrl } from '../../lib/photo';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { asset, url } from '../../lib/utils';
const avions = (await getCollection('avions', (a) => a.data.actif)).sort((a, b) => a.data.ordre - b.data.ordre);
import pages from '../../data/pages.json';
---
<Base univers="voler" title="La flotte" description="Les avions de l'aéroclub de Beauvais-Tillé : Robin DR400, DR300 et Jodel D120.">
  <PageHead eyebrow="Notre flotte" image={pages.flotte.image} title={pages.flotte.titre.replace('{nombre}', String(avions.length))} lead={pages.flotte.texte} />
  <section class="flotte" aria-label="Les avions">
    {avions.map((a, i) => (
      <article class="avion" id={a.id}>
        <div class="a-tete">
          <span class="a-num">{String(i + 1).padStart(2, '0')} / {String(avions.length).padStart(2, '0')}</span>
          {a.data.usage && <span class="a-usage">{a.data.usage}</span>}
        </div>
        <div class="a-grille">
          {a.data.immatriculation && <p class="immat" data-glisse aria-hidden="true">{a.data.immatriculation}</p>}
          <div class="a-photo" data-clip>
            {a.data.photos[0] && <img {...photo(a.data.photos[0], '(min-width: 900px) 60vw, 100vw')} alt={a.data.nom} loading={i < 2 ? 'eager' : 'lazy'} />}
          </div>
          <div class="a-infos">
            <h2 data-sans-italique>{a.data.nom}</h2>
            <dl class="fiche">
              {a.data.immatriculation && <div><dt>Immatriculation</dt><dd>{a.data.immatriculation}</dd></div>}
              {a.data.puissance && <div><dt>Puissance</dt><dd>{a.data.puissance} ch</dd></div>}
              {a.data.places && <div><dt>Places</dt><dd>{a.data.places}</dd></div>}
            </dl>
            {a.data.description && <p class="desc">{a.data.description}</p>}
            {a.data.photos.length > 1 && (
              <div class="vignettes">
                {a.data.photos.slice(1, 4).map((p) => <a href={asset(p)} target="_blank" aria-label={`Photo de ${a.data.nom}`}><img {...photo(p, '200px')} alt="" loading="lazy" /></a>)}
              </div>
            )}
          </div>
        </div>
      </article>
    ))}
  </section>
  <section class="section">
    <div class="container" style="text-align:center">
      <h2 data-split>{pages.flotte.intertitres.fin}</h2>
      <a class="btn btn-primary" data-reveal="scale" href={url('/club/tarifs')}>Voir les tarifs</a>
    </div>
  </section>
</Base>
<style>
  /* Un avion = un chapitre : son immatriculation en très grand, une grande photo, une fiche en filets */
  .flotte { padding: clamp(24px, 4vw, 56px) 0 0; }
  .avion { width: min(var(--max), 100% - 2 * clamp(20px, 4vw, 56px)); margin: 0 auto; padding: clamp(32px, 5vw, 72px) 0; border-bottom: 1px solid var(--line); scroll-margin-top: 80px; }
  .a-tete { display: flex; justify-content: space-between; gap: 16px; font-family: var(--font-title); font-size: .74rem; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); padding-bottom: 14px; border-bottom: 1px solid var(--ink); }
  /* Immatriculation géante en filigrane derrière la fiche, qui glisse vers la gauche quand on fait défiler la page */
  .immat { position: absolute; z-index: 0; top: -.06em; left: 38%; margin: 0; pointer-events: none; user-select: none; font-family: var(--font-title); font-weight: 700; font-size: clamp(6rem, 19vw, 17rem); letter-spacing: -.04em; line-height: .8; color: color-mix(in srgb, var(--ink) 4%, transparent); white-space: nowrap; }
  .avion:nth-child(even) .immat { left: auto; right: 38%; }
  .a-grille > :not(.immat) { position: relative; z-index: 1; }
  .avion { overflow: hidden; }
  .a-grille { position: relative; display: grid; gap: clamp(24px, 4vw, 64px); grid-template-columns: 1.5fr 1fr; align-items: start; }
  .avion:nth-child(even) .a-grille { grid-template-columns: 1fr 1.5fr; }
  .avion:nth-child(even) .a-photo { order: 2; }
  .a-photo { border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 3; background: var(--paper-2); }
  .a-photo img { width: 100%; height: 100%; object-fit: cover; }
  .a-infos h2 { font-size: clamp(1.9rem, 3.2vw, 3rem); margin: 0 0 24px; }
  .fiche { margin: 0 0 24px; border-top: 1px solid var(--line); }
  .fiche div { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .fiche dt { color: var(--muted); font-size: .9rem; }
  .fiche dd { margin: 0; font-family: var(--font-title); font-size: 1.05rem; color: var(--ink); text-align: right; }
  .desc { color: var(--muted); max-width: 46ch; }
  .vignettes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 24px; }
  .vignettes a { display: block; border-radius: var(--radius); overflow: hidden; }
  .vignettes img { aspect-ratio: 1; width: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .vignettes a:hover img { transform: scale(1.06); }
  @media (max-width: 899px) {
    .a-grille, .avion:nth-child(even) .a-grille { grid-template-columns: minmax(0, 1fr); }
    .avion:nth-child(even) .a-photo { order: 0; }
  }
  /* Téléphone : un avion par écran, le défilement s'arrête sur chacun */
  @media (max-width: 599px) {
    .avion { min-height: calc(100svh - 76px); padding: 20px 0 28px; scroll-margin-top: 76px; }
    .immat, .avion:nth-child(even) .immat { position: relative; top: auto; left: auto; right: auto; font-size: 30vw; margin: 4px 0 -.42em; color: color-mix(in srgb, var(--ink) 7%, transparent); }
    .a-photo { aspect-ratio: 4 / 3; }
    .a-infos h2 { font-size: 1.7rem; margin-bottom: 14px; }
    .fiche div { padding: 9px 0; }
    
    .desc { font-size: .95rem; margin-bottom: 0; }
    .vignettes { gap: 6px; margin-top: 16px; }
  }
</style>
