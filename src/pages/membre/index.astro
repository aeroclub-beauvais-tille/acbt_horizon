---
import MembreApp from '../../layouts/MembreApp.astro';
import DocLien from '../../components/DocLien.astro';
import Metar from '../../components/MetarMembre.astro';
import Taf from '../../components/Taf.astro';
import Logo from '../../components/Logo.astro';
import { getCollection } from 'astro:content';
import { RUBRIQUES_AVION, TYPES_AVION } from '../../content.config';
import AdminDocs from '../../components/AdminDocs.astro';
import { titreDoc, marquerHistorique, estOfficiel, type Doc } from '../../lib/documents';
import outils from '../../data/outils.json';
import club from '../../data/club.json';
import { asset, url, cleFormulaire } from '../../lib/utils';

const brut = await getCollection('documents');
const docs = marquerHistorique(brut.map((d) => ({ id: d.id, ...d.data } as Doc)))
  .sort((a, b) => a.ordre - b.ordre || titreDoc(a).localeCompare(titreDoc(b), 'fr'));
const vivants = (c: string) => docs.filter((d) => d.categorie === c && !d.archive);

const avions = (await getCollection('avions', (a) => a.data.actif)).sort((a, b) => a.data.ordre - b.data.ordre);
const docsAvion = docs.filter((d) => d.categorie === 'Documentation avion');
const rangType = (d: Doc) => { const i = TYPES_AVION.indexOf((d.type ?? '') as (typeof TYPES_AVION)[number]); return i < 0 ? 99 : i; };
const rangRub = (d: Doc) => RUBRIQUES_AVION.indexOf((d.rubrique ?? 'Autre') as (typeof RUBRIQUES_AVION)[number]);
const modele = (t: string) => t.replace(/-\d+.*$| Petit Prince| Paris-Nice/g, '').trim();

// Documents à emporter lors d'un vol (« le minimum exigé »), dans cet ordre. La fiche de pesée n'est pas affichée.
const REQUIS: { nom: string; types?: string[]; rubrique?: string }[] = [
  { nom: 'Certificat d’immatriculation', types: ["Certificat d'immatriculation"] },
  { nom: 'Certificat de navigabilité', types: ['Certificat de navigabilité (CDN)'] },
  { nom: 'Certificat d’examen de navigabilité', types: ["Certificat d'examen de navigabilité (CEN)"] },
  { nom: 'Licence station radio (LSA)', types: ['Licence station radio', 'Autorisation radio'] },
  { nom: 'Certificat de limitation de nuisance', types: ['Certificat acoustique'] },
  { nom: 'Attestation d’assurance RC', types: ['Assurance'] },
  { nom: 'Manuel de vol', rubrique: 'Manuel de vol' },
];
const PIECES_PILOTE = ['Licence', 'Certificat médical', 'CNI'];
const estPesee = (d: Doc) => d.type === 'Fiche de pesée et centrage' || /pes[ée]e/i.test(d.titre ?? '');

const flotte = avions.map((a) => {
  const im = a.data.immatriculation ?? a.data.nom;
  const mine = docsAvion.filter((d) => d.avions.includes(im) && !estPesee(d));
  const vivants = mine.filter((d) => !d.archive);
  const pris = new Set<string>();
  const requis = REQUIS.map((r) => {
    const doc = vivants.find((d) => !pris.has(d.id) && (r.types ? r.types.includes(d.type ?? '') : !estOfficiel(d) && d.rubrique === r.rubrique));
    if (doc) pris.add(doc.id);
    return { nom: r.nom, doc };
  });
  // Autres documents officiels de l'avion (type non listé ci-dessus) : à la suite, avec leur badge
  const autres = vivants.filter((d) => estOfficiel(d) && !pris.has(d.id)).sort((p, q) => rangType(p) - rangType(q));
  return {
    id: a.id, im, modele: modele(a.data.type), photo: a.data.photos[0],
    requis, autres,
    techniques: vivants.filter((d) => !estOfficiel(d) && !pris.has(d.id)).sort((p, q) => rangRub(p) - rangRub(q)),
    historique: mine.filter((d) => d.archive).sort((p, q) => rangType(p) - rangType(q)),
  };
});

// Bulletins météo (MAA) — gérés à part (horaires précis, pas « à renouveler »)
const meteo = docs.filter((d) => d.type === 'Bulletin météo' && !d.archive).sort((a, b) => (a.debut?.getTime() ?? 0) - (b.debut?.getTime() ?? 0));
const memos = ['Sécurité', 'Préparation des vols', 'Météo', 'Formulaires']
  .map((c) => ({ c, docs: vivants(c).filter((d) => !estOfficiel(d)) })).filter((x) => x.docs.length);
// Données pour le mode admin (mêmes informations que les fiches, déjà publiques)
const jour = (d?: Date) => d ? d.toISOString().slice(0, 10) : undefined;
const adminDonnees = {
  version: process.env.GITHUB_SHA || '',
  types: [...TYPES_AVION], rubriques: [...RUBRIQUES_AVION],
  docs: docs.map((d) => ({ id: d.id, titre: d.titre, type: d.type, rubrique: d.rubrique, avions: d.avions, debut: jour(d.debut), fin: jour(d.fin), fichier: d.fichier, lien: d.lien, ordre: d.ordre, remplace: d.remplace, archive: d.archive })),
};
const host = (l: string) => new URL(l).hostname.replace(/^www\./, '');
const connexion = url('/membre/connexion/');
// Modèle affiché dans l'onglet Flotte. Les avions qui sont dans Aerogest mais pas encore dans le contenu du site sont listés ici.
const modeles = { 'F-BTBJ': 'DR315', ...Object.fromEntries(flotte.map((a) => [a.im, a.modele.replace(/^Robin |^Jodel /, '')])) };

const onglets = [
  { id: 'accueil', nom: 'Météo', svg: 'M17.5 19a4.5 4.5 0 1 0-.9-8.9A6 6 0 1 0 6 19h11.5z' },
  { id: 'flotte', nom: 'Flotte', svg: 'M12 14l4.5-4.5M3.5 18a9.5 9.5 0 1 1 17 0M12 14h.01' },
  { id: 'avions', nom: 'Avions', svg: 'M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z' },
  { id: 'preparer', nom: 'Préparer', svg: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 4v12m10-6H2' },
];
---
<MembreApp title="Espace membres">
  <script slot="head" is:inline define:vars={{ connexion }}>
    try {
      var ret = '?retour=' + encodeURIComponent(location.pathname + location.hash);
      if (!localStorage.getItem('acbt-membre')) location.replace(connexion + ret);
      // Sur téléphone, ouvert dans le navigateur (et pas dans l'appli installée) : on propose d'abord d'installer l'appli
      else if (/android|iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) {
        var appli = matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
        if (!appli && !sessionStorage.getItem('acbt-navigateur')) location.replace(connexion + ret);
      }
    } catch (e) {}
  </script>

  <header class="topbar">
    <a class="marque" href={url('/membre/')} aria-label="Accueil espace membres"><Logo class="logo" /><span>Espace membres</span></a>
    <div class="actions">
      <button type="button" class="ic" id="btn-theme" aria-label="Changer de thème"></button>
      <button type="button" class="ic" id="btn-recherche" aria-label="Rechercher un document">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4-4" /></svg>
      </button>
      <button type="button" class="ic" id="installer" aria-label="Installer l'appli" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5" /><path d="M12 7v7M9 11l3 3 3-3M10.5 18.5h3" /></svg>
      </button>
      <button type="button" class="ic" id="deconnexion" aria-label="Se déconnecter">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
      </button>
    </div>
  </header>

  <div class="searchwrap" id="searchwrap" hidden>
    <input type="search" id="q" placeholder="Rechercher un document…" autocomplete="off" />
    <button type="button" id="fermer-recherche" aria-label="Fermer la recherche">✕</button>
  </div>
  <p class="aucun" id="aucun" hidden>Aucun document ne correspond.</p>

  <main class="content">
    <!-- ACCUEIL -->
    <section class="panneau" id="accueil">
      <div id="maa-zone" hidden>
        {meteo.map((m) => (
          <a class="maa-banniere" data-maa data-numero={m.numero} data-debut={m.debut?.toISOString()} data-fin={m.fin?.toISOString()} href={m.fichier ? asset(m.fichier) : (m.lien || undefined)} target="_blank" rel="noopener" hidden>
            <span class="maa-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L1 21h22L12 2z" /><path d="M12 9v5M12 17.5v.01" /></svg></span>
            <span class="maa-txt">
              <strong data-maa-titre>Avertissement météo en cours</strong>
              <span class="maa-num">MAA n°{m.numero ?? '—'}</span>
            </span>
            <span class="maa-pdf">PDF ↗</span>
          </a>
        ))}
      </div>
      <p class="maa-rien" id="maa-rien" hidden>
        <span class="maa-rien-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg></span>
        <span>Pas de MAA en cours ni prévu</span>
      </p>
      <template id="maa-modele">
        <a class="maa-banniere" data-maa target="_blank" rel="noopener" hidden>
          <span class="maa-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L1 21h22L12 2z" /><path d="M12 9v5M12 17.5v.01" /></svg></span>
          <span class="maa-txt">
            <strong data-maa-titre>Avertissement météo en cours</strong>
            <span class="maa-num">MAA</span>
          </span>
          <span class="maa-pdf">PDF ↗</span>
        </a>
      </template>

      <div class="soleil" id="soleil" aria-label="Soleil à LFOB, heures locales">
        <div class="sol-cases">
          <div class="aero"><small>Jour aéro.</small><b><span data-soleil="jourAero">--:--</span><i>LT</i></b></div>
          <div><small>Lever</small><b><span data-soleil="lever">--:--</span><i>LT</i></b></div>
          <div><small>Coucher</small><b><span data-soleil="coucher">--:--</span><i>LT</i></b></div>
          <div class="aero"><small>Nuit aéro.</small><b><span data-soleil="nuitAero">--:--</span><i>LT</i></b></div>
        </div>
        <div class="sol-bas" data-soleil-etat="jour">
          <div class="sol-cd"><span data-soleil-txt>Nuit aéro. dans</span><b data-soleil-val></b></div>
          <div class="sol-frise" aria-hidden="true"><span class="f" data-soleil-f></span><span class="lc" data-soleil-l></span><span class="lc" data-soleil-c></span><span class="now" data-soleil-now></span></div>
        </div>
      </div>

      <h2 class="bt">Météo du terrain</h2>
      <div class="carte-metar"><Metar /></div>
      <div class="carte-metar carte-taf"><Taf /></div>

      <p class="aide-ios" id="aide-ios" hidden>Sur iPhone : touchez <b>Partager</b> en bas de Safari, puis <b>Sur l'écran d'accueil</b>.</p>
    </section>

    <!-- FLOTTE -->
    <section class="panneau" id="flotte" hidden>
      <h1 class="titre">Flotte</h1>
      <div class="fl-liste" id="flotte-liste" data-api={url('/membre/api/flotte')} data-modeles={JSON.stringify(modeles)}></div>
      <p class="fl-info" id="flotte-info"></p>
    </section>

    <!-- AVIONS -->
    <section class="panneau" id="avions" hidden>
      <h1 class="titre">Documents par avion</h1>
      <div class="adm-barre" id="adm-barre">
        <span class="adm-pill">Mode admin</span>
        <span class="adm-barre-txt"></span>
        <button type="button" id="adm-quitter">Quitter</button>
      </div>
      <p class="adm-attente" id="adm-attente" hidden>Publication en cours : l'appli sera à jour d'ici 2 à 3 minutes.</p>
      <div class="alerte-docs" id="alerte-docs">
        <div data-pleine hidden>
          <h2 class="bt bt-rouge"><span class="pt-alerte" aria-hidden="true">!</span>Documents à renouveler</h2>
          <ul class="liste-alerte" data-liste></ul>
        </div>
      </div>
      <span class="av-lbl">Avion</span>
      <div class="av-voile" aria-hidden="true"></div>
      <div class="av-select" id="selecteur">
        <button type="button" class="av-trig" id="av-trig" data-vide="oui" aria-haspopup="listbox" aria-expanded="false" aria-label="Choisir un avion">
          <span class="av-trig-dot av-dot" aria-hidden="true"></span>
          <svg class="av-trig-plane" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z" /></svg>
          <span class="av-trig-main"><span class="av-trig-txt">Choisir un avion</span><span class="av-trig-sub"></span></span>
          <span class="av-trig-st av-st" aria-hidden="true"></span>
          <svg class="av-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </button>
        <div class="av-menu" id="av-menu" role="listbox" aria-label="Avions du club" hidden>
          {flotte.map((x) => (
            <button type="button" class="av-opt" data-avion={x.im} role="option" aria-selected="false">
              <span class="av-dot" aria-hidden="true"></span>
              <span class="av-id"><b>{x.im}</b><small>{x.modele}</small></span>
              <span class="av-st" aria-hidden="true"></span>
            </button>
          ))}
        </div>
      </div>
      <div class="fiches" id="fiches">
        {flotte.map((x) => (
          <article class="fiche cache" data-ims={x.im}>
            <header>
              <div><h3>{x.im}</h3><span class="av-mod">{x.modele}</span></div>
            </header>
            <button type="button" class="signaler" data-signaler data-avion={x.im}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /><path d="M12 9v4M12 17h.01" /></svg>
              Signaler un problème technique
            </button>
            <a class="sig-liste" href={url('/membre/signalements/') + '?avion=' + encodeURIComponent(x.im)}>Signalements en cours sur {x.im}</a>
            <button type="button" class="adm-depot" data-depot={x.im} hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5" /><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" /></svg>
              <span><b>Ajouter un document</b><small>Glissez un fichier ici ou touchez pour choisir</small></span>
            </button>
            <div class="fiche-cols"><div>
            <h5 class="sep sep-col">Documents nécessaires au vol<span>Validité</span></h5>
            <div class="liste compacte">
              {x.requis.map((r) => r.doc
                ? <DocLien doc={r.doc} court={r.nom} badge vers="avions" ligne />
                : <DocLien doc={{ titre: r.nom }} manquant ligne />)}
              {x.autres.map((d) => <DocLien doc={d} vers="avions" ligne />)}
            </div>
            <div class="pilote"><span class="pilote-t">Pilote</span>{PIECES_PILOTE.map((p) => <span class="piece">{p}</span>)}</div>
            </div><div>
            {x.techniques.length > 0 && <h5 class="sep">Manuels d’utilisation du matériel</h5>}
            <div class="liste">{x.techniques.map((d) => <DocLien doc={d} court={titreDoc(d).replace(` ${x.im}`, '')} />)}</div>
            </div></div>
            {x.historique.length > 0 && (
              <details class="histo"><summary>Historique ({x.historique.length})</summary><div class="liste">{x.historique.map((d) => <DocLien doc={d} vers="avions" />)}</div></details>
            )}
          </article>
        ))}
      </div>
      <a class="adm-lien" href={url('/membre/admin/')}>Administration</a>
    </section>

    <!-- PRÉPARER -->
    <section class="panneau" id="preparer" hidden>
      <h1 class="titre">Préparer son vol</h1>
      {outils.categories.map((c) => (
        <div class="bloc">
          <h5 class="sep">{c.titre}</h5>
          <div class="outils">
            {c.outils.map((o) => { const interne = (o as { membre?: string }).membre; return (
              <a class="outil" href={interne ? url(interne) : o.lien} target={interne ? undefined : '_blank'} rel={interne ? undefined : 'noopener'} data-q={`${o.nom} ${o.description}`.toLowerCase()}>
                <span class="o-logo" data-init={o.nom.replace(/[^A-Za-zÀ-ÿ0-9]/g, '').slice(0, 2).toUpperCase()}>
                  <img src={(o as { logo?: string }).logo ? asset((o as { logo?: string }).logo!) : `https://www.google.com/s2/favicons?domain=${host(o.lien)}&sz=128`} alt="" width="34" height="34" loading="lazy" onerror="this.remove()" />
                </span>
                <span class="o-txt"><b>{o.nom}{interne ? '' : ' ↗'}</b><small>{o.description}</small></span>
              </a>
            ); })}
          </div>
        </div>
      ))}
      {vivants('Documentation pilote').length > 0 && <div class="bloc"><h5 class="sep">Terrain et espace aérien</h5><div class="liste">{vivants('Documentation pilote').map((d) => <DocLien doc={d} />)}</div></div>}
      {memos.map((x) => <div class="bloc"><h5 class="sep">{x.c}</h5><div class="liste">{x.docs.map((d) => <DocLien doc={d} />)}</div></div>)}
    </section>
  </main>

  <nav class="tabbar" id="onglets" aria-label="Sections">
    {onglets.map((o) => (
      <button type="button" data-onglet={o.id} aria-selected={o.id === 'accueil'}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={o.svg} /></svg>
        <span>{o.nom}</span>
      </button>
    ))}
  </nav>

  <dialog class="modale" id="signalement" aria-label="Signaler un problème technique" data-api={url('/membre/api/signalements')} data-cle-mail={cleFormulaire(club.formulaire_cle)} data-page={url('/membre/signalements/')}>
    <form method="dialog">
      <div class="m-head">
        <h3>Signaler un problème</h3>
        <button type="button" class="m-x" data-fermer aria-label="Fermer">✕</button>
      </div>

      <div class="m-corps" data-etape="saisie">
        <div class="m-avion"><span class="m-av-lbl">Avion</span><span class="m-av-im" id="sig-avion">—</span></div>
        <label for="sig-nom">Votre nom</label>
        <input id="sig-nom" type="text" autocomplete="name" maxlength="60" placeholder="Prénom Nom" />
        <label for="sig-desc">Problème constaté</label>
        <textarea id="sig-desc" rows="4" placeholder="Ex. pneu principal droit usé, radio qui grésille…"></textarea>
        <label>Photos <span class="m-opt">facultatif</span></label>
        <div class="m-photos" id="sig-photos" hidden></div>
        <button type="button" class="m-ajout" id="sig-ajout">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1h-3l-2.5-3z" /><circle cx="12" cy="13" r="3.2" /></svg>
          Ajouter des photos
        </button>
        <input type="file" id="sig-fichiers" accept="image/*" multiple hidden />
        <p class="m-erreur" id="sig-erreur" role="alert" hidden></p>
      </div>

      <div class="m-corps m-reussi" data-etape="ok" hidden>
        <span class="m-ok-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg></span>
        <strong>Signalement envoyé</strong>
        <span id="sig-retour">Les responsables techniques sont prévenus.</span>
        <a class="m-lien" href={url('/membre/signalements/')}>Voir tous les signalements</a>
        <button type="button" class="m-pri" data-fermer>Fermer</button>
      </div>

      <div class="m-pied" id="sig-pied">
        <button type="button" class="m-sec" data-fermer>Annuler</button>
        <button type="button" class="m-pri" id="sig-envoyer">Envoyer</button>
      </div>
    </form>
  </dialog>

  <AdminDocs />
  <script type="application/json" id="admin-donnees" set:html={JSON.stringify(adminDonnees).replace(/</g, '\\u003c')} />
</MembreApp>

<script>
  import { enregistrer, boutonInstaller, seDeconnecter, badges, maa, maaEnLigne, onglets, signalement, theme, avions, soleil, flotte } from '../../scripts/membre-app';
  enregistrer();
  theme(document.getElementById('btn-theme'));
  const montrer = onglets();
  badges();
  avions();
  maa();
  maaEnLigne();
  soleil();
  setInterval(soleil, 60_000);
  flotte();
  setInterval(maaEnLigne, 5 * 60_000); // nouveaux MAA reçus par mail
  setInterval(maa, 60_000); // le MAA peut commencer ou se terminer pendant la consultation
  signalement();
  try { if (localStorage.getItem('acbt-admin-jeton')) import('../../scripts/membre-admin').then((m) => m.modeAdmin()); } catch { /* privé */ }
  boutonInstaller(document.getElementById('installer') as HTMLButtonElement, document.getElementById('aide-ios'));
  document.getElementById('deconnexion')?.addEventListener('click', () => {
    if (confirm('Se déconnecter sur cet appareil ? Les documents gardés hors ligne seront effacés.')) seDeconnecter();
  });
  document.querySelectorAll<HTMLElement>('.liste-alerte').forEach((ul) =>
    ul.addEventListener('click', (ev) => { const li = (ev.target as HTMLElement).closest<HTMLElement>('[data-vers]'); if (li?.dataset.vers) montrer?.(li.dataset.vers); }));

  // Recherche (derrière une icône, ne masque pas la barre d'onglets)
  const sw = document.getElementById('searchwrap');
  const q = document.getElementById('q') as HTMLInputElement | null;
  const aucun = document.getElementById('aucun');
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const ouvrir = (o: boolean) => { if (sw) sw.hidden = !o; if (o) q?.focus(); else if (q) { q.value = ''; q.dispatchEvent(new Event('input')); } };
  document.getElementById('btn-recherche')?.addEventListener('click', () => ouvrir(sw?.hidden ?? true));
  document.getElementById('fermer-recherche')?.addEventListener('click', () => ouvrir(false));
  q?.addEventListener('input', () => {
    const v = norm(q.value.trim());
    document.body.classList.toggle('recherche', !!v);
    document.querySelectorAll<HTMLElement>('[data-q]').forEach((el) => { el.hidden = !!v && !norm(el.dataset.q || '').includes(v); });
    if (aucun) aucun.hidden = !v || !!document.querySelector('[data-q]:not([hidden])');
  });
</script>

<style>
  .titre { font-size: 1.4rem; margin: 0 0 16px; letter-spacing: -.01em; }
  .bt { font-size: .82rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); font-weight: 700; margin: 0 0 10px; display: flex; align-items: center; gap: 9px; }
