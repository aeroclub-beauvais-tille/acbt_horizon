  :global(.fl-jauge.fl-warn i) { background: var(--warn); }
  :global(.fl-jauge.fl-bad i) { background: var(--bad); width: 100% !important; }
  :global(.fl-carte dl) { margin: 0; display: grid; gap: 0; }
  :global(.fl-carte dl div) { display: grid; row-gap: 1px; padding: 8px 0; border-top: 1px solid var(--line); font-size: .9rem; }
  :global(.fl-carte dd.fl-nom) { font-weight: 600; color: var(--ink-2, var(--ink)); }
  /* Avion indisponible (maintenance) : carte hachurée en diagonale + bandeau */
  :global(.fl-carte.fl-hs) { background: var(--surface) repeating-linear-gradient(135deg, transparent 0 11px, var(--bad-line) 11px 12.5px); border-color: var(--bad-line); }
  :global(.fl-hs dl) { background: var(--surface); border-radius: 8px; padding: 0 10px; margin: 0 -10px; }
  :global(.fl-indispo) { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; background: var(--surface); border: 1px solid var(--bad-line); border-left: 4px solid var(--bad); border-radius: 10px; padding: 8px 12px; margin: 2px 0 8px; font-size: .86rem; }
  :global(.fl-indispo b) { color: var(--bad); font-weight: 800; }
  :global(.fl-indispo span) { font-weight: 700; }
  :global(.fl-hs .fl-pot), :global(.fl-hs .fl-jauge) { opacity: .55; }
