---
// L'espace membres est une seule appli, commune à toutes les versions du site :
// celle de hugoflying/acbt (/acbt/membre/). Ici, on redirige simplement vers elle.
const APPLI = 'https://hugoflying.github.io/acbt/membre/';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Espace membres · ACBT</title>
    <meta http-equiv="refresh" content={`0; url=${APPLI}`} />
    <link rel="canonical" href={APPLI} />
    <script is:inline define:vars={{ APPLI }}>location.replace(APPLI);</script>
    <style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#0b1e4f;color:#fff;font:600 16px system-ui,sans-serif}a{color:#ffad00}</style>
  </head>
  <body><p>Ouverture de l'espace membres… <a href={APPLI}>continuer</a></p></body>
</html>
