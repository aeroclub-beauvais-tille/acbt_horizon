  /* Alerte documents */
  .alerte-docs { margin: 0; }
  .alerte-docs [data-pleine] { margin-bottom: 18px; }
  .bt-rouge { color: var(--bad); }
  .pt-alerte { flex: none; width: 22px; height: 22px; border-radius: 50%; background: var(--bad); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: .8rem; }
  .liste-alerte { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  :global(.liste-alerte .al) { display: flex; gap: 10px; align-items: center; padding: 11px 13px; border-radius: 12px; border: 1px solid; font-size: .9rem; cursor: pointer; }
  :global(.liste-alerte .al[hidden]) { display: none; }
  :global(.liste-alerte .al-t) { flex: 1; min-width: 0; }
  :global(.liste-alerte .al-e) { flex: none; font-weight: 700; font-size: .82rem; white-space: nowrap; }
  :global(.liste-alerte .pt) { flex: none; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  :global(.liste-alerte .al-expire) { color: var(--bad); background: var(--bad-bg); border-color: var(--bad-line); }
  :global(.liste-alerte .al-bientot) { color: var(--warn); background: var(--warn-bg); border-color: var(--warn-line); }
  :global(.liste-alerte b) { color: var(--ink); }
  .ok { display: flex; align-items: center; gap: 10px; color: var(--ok); background: var(--ok-bg); border: 1px solid var(--ok-line); border-radius: 12px; padding: 12px 15px; margin: 0; font-weight: 600; font-size: .92rem; }
  .ok svg { width: 20px; height: 20px; flex: none; }

  .aide-ios { font-size: .88rem; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; margin: 10px 0 0; }



  /* Sélecteur avion — menu déroulant façon « vue flotte » */
  .av-lbl { display: block; font-size: .74rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; color: var(--muted); margin: 2px 0 8px; }
  .av-select { position: relative; margin: 0 0 18px; }
  /* Liste ouverte : le reste de l'écran est flouté et assombri pour faire ressortir la liste */
  .av-voile { position: fixed; inset: 0; z-index: 40; background: rgba(8,16,36,.32); -webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px); opacity: 0; pointer-events: none; transition: opacity .15s ease; }
  .av-voile:has(+ .av-select .av-trig[aria-expanded='true']) { opacity: 1; pointer-events: auto; }
  .av-select:has(.av-trig[aria-expanded='true']) { z-index: 41; }
  .av-dot { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  .av-dot.av-ok { background: var(--ok); } .av-dot.av-warn { background: var(--warn); } .av-dot.av-bad { background: var(--bad); }
  .av-st { font-size: .82rem; font-weight: 700; flex: none; }
  .av-st.av-ok { color: var(--ok); } .av-st.av-warn { color: var(--warn); } .av-st.av-bad { color: var(--bad); }

  .av-trig { display: flex; align-items: center; gap: 11px; width: 100%; text-align: left; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 13px 14px; box-shadow: var(--shadow); color: var(--ink); font: inherit; cursor: pointer; }
  .av-trig:active { transform: scale(.995); }
  .av-trig-plane { width: 22px; height: 22px; flex: none; color: var(--muted); }
  .av-trig-main { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.2; }
  .av-trig-txt { font-family: var(--mono); font-weight: 600; font-size: 1.02rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .av-trig[data-vide='oui'] .av-trig-txt { font-family: var(--font); font-weight: 700; color: var(--muted); }
  .av-trig-sub { font-size: .82rem; color: var(--muted); }
  .av-trig-sub:empty { display: none; }
  .av-chev { width: 20px; height: 20px; flex: none; color: var(--muted); transition: transform .15s ease; }
  .av-trig[aria-expanded='true'] .av-chev { transform: rotate(180deg); }
  .av-trig[data-vide='oui'] .av-trig-dot, .av-trig[data-vide='oui'] .av-trig-st { display: none; }
  .av-trig[data-vide='non'] .av-trig-plane { display: none; }

  .av-menu { position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 20; display: flex; flex-direction: column; gap: 2px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,42,90,.16); padding: 6px; }
  .av-opt { display: flex; align-items: center; gap: 11px; width: 100%; text-align: left; background: none; border: 0; border-radius: 10px; padding: 11px 10px; color: var(--ink); font: inherit; cursor: pointer; }
  .av-opt:hover, .av-opt[aria-selected='true'] { background: var(--surface-2); }
  .av-id { flex: 1; min-width: 0; }
  .av-id b { display: block; font-family: var(--mono); font-weight: 600; font-size: 1rem; }
  .av-id small { color: var(--muted); font-size: .82rem; }

  .signaler { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 9px; margin-bottom: 16px; padding: 11px 14px; border: 1px solid var(--bad-line); background: var(--bad-bg); color: var(--bad); border-radius: 12px; font: inherit; font-weight: 650; font-size: .92rem; cursor: pointer; }
  .sig-liste { display: block; margin: -8px 0 16px; text-align: center; font-size: .86rem; font-weight: 650; color: var(--accent-text); }
  .signaler svg { width: 18px; height: 18px; flex: none; }
  .signaler:active { transform: scale(.99); }

  .fiches { display: grid; gap: 14px; }
  /* Une seule fiche affichée à la fois (l'avion choisi) : pleine largeur ; sur grand écran, documents et manuels côte à côte */
  @media (min-width: 900px) {
    .fiche { padding: 20px 22px; }
    .fiche-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 0 22px; align-items: start; }
    .fiche-cols > div > .sep:first-child { margin-top: 0; }
    .signaler { width: auto; padding-inline: 18px; }
  }
  .fiche-cols > div + div > .sep:first-child { margin-top: 22px; }
  @media (min-width: 900px) {
    .content { max-width: 980px; }
    .topbar { padding-inline: max(14px, calc((100% - 980px) / 2 + 14px)); }
    #accueil { max-width: 760px; margin-inline: auto; }
    .fiche-cols > div + div > .sep:first-child { margin-top: 0; }
    .outils { grid-template-columns: 1fr 1fr 1fr; }
  }
  /* Grand écran : la barre d'onglets reste groupée au centre, alignée sur le contenu */
  @media (min-width: 820px) {
    .tabbar { justify-content: center; }
    .tabbar button { flex: 0 1 240px; }
  }
  .fiche { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 15px; }
  .fiche.cache { display: none; }
  .fiche header { display: flex; gap: 12px; align-items: center; margin-bottom: 14px; }
  .fiche h3 { margin: 0; font-size: 1.2rem; }
  .av-mod { font-size: .82rem; color: var(--muted); }
  .liste { display: grid; gap: 8px; }
  .liste.compacte { gap: 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .liste.compacte > :global(* + *) { border-top: 1px solid var(--line); }
  .rien { color: var(--muted); font-size: .88rem; margin: 0; }
  .pilote { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 10px; }
  .pilote-t { font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-right: 4px; }
  .piece { font-size: .8rem; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); }
  .histo { margin-top: 14px; border-top: 1px solid var(--line); padding-top: 12px; }
  .histo summary { cursor: pointer; font-size: .84rem; font-weight: 600; color: var(--muted); }
  .histo .liste { margin-top: 10px; }

  /* MAA en ligne (Club) */
  .maa-row { display: flex; gap: 11px; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 11px 13px; text-decoration: none; color: inherit; }
  .maa-row:active { transform: scale(.99); }
  .maa-sub { display: flex; align-items: center; gap: 8px; margin-top: 5px; flex-wrap: wrap; }
  .maa-chip { flex: none; font-size: .72rem; font-weight: 700; padding: 2px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); background: var(--surface-2); }
  .maa-row[data-etat='en-cours'] .maa-chip { color: var(--bad); background: var(--bad-bg); border-color: var(--bad-line); }

  /* Outils */
