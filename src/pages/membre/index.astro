  .carte-metar { padding: 15px 16px; background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 14px; }
  .carte-taf { margin-top: 10px; }

  /* Soleil (en haut de l'onglet Météo, sous le MAA) : 4 heures + compte à rebours et frise du jour aéronautique */
  .soleil { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; margin-bottom: 18px; overflow: hidden; }
  .sol-cases { display: grid; grid-template-columns: repeat(4, 1fr); }
  .sol-cases > div { padding: 10px 4px 9px; text-align: center; border-left: 1px solid var(--line); }
  .sol-cases > div:first-child { border-left: 0; }
  .soleil small { display: block; color: var(--muted); font-size: .72rem; font-weight: 600; margin-bottom: 2px; white-space: nowrap; }
  .soleil b { font-size: 1.15rem; font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .soleil b i { font-style: normal; font-size: .58rem; font-weight: 700; color: var(--muted); margin-left: 3px; letter-spacing: .03em; }
  .sol-cases .aero b span { color: var(--accent-text, var(--accent)); }
  .sol-bas { border-top: 1px solid var(--line); padding: 9px 14px 12px; }
  .sol-cd { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: .82rem; font-weight: 600; color: var(--muted); margin-bottom: 8px; }
  .sol-cd b { font-size: .95rem; color: var(--ink); }
  .sol-frise { position: relative; height: 8px; border-radius: 9px; background: var(--surface-2); }
  .sol-frise .f { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 9px; background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent); }
  .sol-frise .lc { position: absolute; top: -3px; bottom: -3px; width: 2px; border-radius: 2px; background: var(--line); }
  .sol-frise .now { position: absolute; top: 50%; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); border: 3px solid var(--surface); box-shadow: 0 0 0 1px var(--accent); transform: translate(-50%, -50%); }
  .sol-bas[data-soleil-etat='proche'] .sol-cd b { color: var(--warn); }
  .sol-bas[data-soleil-etat='proche'] .f { background: var(--warn-bg); box-shadow: inset 0 0 0 1px var(--warn); }
  .sol-bas[data-soleil-etat='proche'] .now { background: var(--warn); box-shadow: 0 0 0 1px var(--warn); }
  /* Nuit aéronautique : frise entièrement hachurée */
  .sol-bas[data-soleil-etat='nuit'] .sol-cd b { color: var(--accent-text, var(--accent)); }
  .sol-bas[data-soleil-etat='nuit'] .f { width: 100% !important; background: repeating-linear-gradient(135deg, var(--muted) 0 2px, transparent 2px 6px); box-shadow: inset 0 0 0 1px var(--muted); opacity: .7; }
  .sol-bas[data-soleil-etat='nuit'] .now { display: none; }
  #maa-zone:not([hidden]), .maa-rien:not([hidden]) { margin-bottom: 12px; }

  /* Flotte */
  .fl-liste { display: grid; gap: 12px; }
  @media (min-width: 640px) { .fl-liste { grid-template-columns: 1fr 1fr; } }
  :global(.fl-carte) { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; }
  :global(.fl-tete) { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  :global(.fl-im) { font-family: var(--mono); font-size: 1.05rem; font-weight: 700; letter-spacing: .02em; }
  :global(.fl-tete small) { color: var(--muted); font-size: .78rem; font-weight: 600; margin-left: 8px; }
  :global(.fl-etat) { display: inline-flex; align-items: center; gap: 6px; font-size: .74rem; font-weight: 700; padding: 3px 10px; border-radius: 99px; border: 1px solid; white-space: nowrap; }
  :global(.fl-etat i) { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  :global(.fl-etat.fl-ok) { color: var(--ok); background: var(--ok-bg); border-color: var(--ok-line); }
  :global(.fl-etat.fl-bad) { color: var(--bad); background: var(--bad-bg); border-color: var(--bad-line); }
  :global(.fl-etat.fl-info) { color: var(--accent-text, var(--accent)); background: var(--accent-soft); border-color: var(--accent-line, var(--line)); }
  :global(.fl-pot) { display: flex; align-items: baseline; gap: 8px; margin-top: 10px; }
  :global(.fl-val) { font-size: 1.75rem; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -.01em; }
  :global(.fl-u) { font-size: .78rem; color: var(--muted); font-weight: 600; }
