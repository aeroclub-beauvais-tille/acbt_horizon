---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { photo } from '../../lib/photo';
import { url, dateFr } from '../../lib/utils';
import { getCollection } from 'astro:content';
const actus = (await getCollection('actualites', (a) => a.data.publie)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const annees = [...new Set(actus.map((a) => a.data.date.getFullYear()))];
import pages from '../../data/pages.json';
---
<Base univers="actus" title="Actualités" description="Les actualités de l'aéroclub de Beauvais-Tillé depuis 2006.">
  <PageHead eyebrow="Le club · Actualités" image={pages.actualites.image} title={pages.actualites.titre} lead={pages.actualites.texte} />
  <section class="section">
    <div class="container">
      <div class="filters" data-filter="annee" data-reveal>
        {annees.map((y, i) => <button aria-pressed={i === 0 ? 'true' : 'false'} data-v={String(y)}>{y}</button>)}
        <button aria-pressed="false" data-v="">Toutes les années</button>
      </div>
      <noscript><style>{'.annee-bloc { display: block !important; }'}</style></noscript>
      {annees.map((y, i) => (
        <div class="annee-bloc" data-annee={y} style={i === 0 ? undefined : 'display:none'}>
          <h2 class="an" data-sans-italique data-reveal>{y}</h2>
          <ol class="liste" data-batch>
            {actus.filter((a) => a.data.date.getFullYear() === y).map((a) => {
              const img = a.data.image ?? a.data.galerie[0];
              return (
                <li class="news" data-annee={y}>
                  <a href={url(`/actualites/${a.id}`)}>
                    <span class="date">{dateFr(a.data.date, { day: 'numeric', month: 'long' })}</span>
                    <span class="titre">{a.data.titre}</span>
                    {img && <img {...photo(img, "200px")} alt="" loading="lazy" />}
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      ))}
    </div>
  </section>
</Base>
<script>
  // Par défaut, seule l'année la plus récente est affichée (la page reste courte) ; les boutons donnent accès aux autres.
  const state: Record<string, string> = { annee: document.querySelector<HTMLElement>('.filters button[aria-pressed="true"]')?.dataset.v ?? '' };
  function apply() {
    document.querySelectorAll<HTMLElement>('.news').forEach((n) => {
      const ok = (!state.annee || n.dataset.annee === state.annee);
      n.style.display = ok ? '' : 'none';
    });
    document.querySelectorAll<HTMLElement>('.annee-bloc').forEach((b) => {
      b.style.display = b.querySelector('.news:not([style*="none"])') ? '' : 'none';
    });
  }
  document.querySelectorAll<HTMLElement>('.filters').forEach((group) => {
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      state[group.dataset.filter!] = btn.dataset.v ?? '';
      apply();
    });
  });
</script>
<style>
  /* Le journal du club : une grande année, puis une liste en filets (date, titre, vignette) */
  .annee-bloc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr); gap: 0 clamp(24px, 5vw, 80px); align-items: start; margin-bottom: 72px; }
  .an { position: sticky; top: 96px; font-weight: 200; font-size: clamp(4rem, 10vw, 9rem); letter-spacing: -.06em; line-height: .85; margin: 0; }
  .liste { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .liste a { display: grid; grid-template-columns: 9.5em 1fr 120px; gap: 24px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .date { font-family: var(--font-title); font-size: .74rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .titre { font-family: var(--font-title); font-weight: 300; font-size: clamp(1.15rem, 1.8vw, 1.55rem); letter-spacing: -.025em; line-height: 1.2; color: var(--ink); transition: color .2s, transform .4s cubic-bezier(.2,.7,.2,1); }
  .liste img, .vide { width: 120px; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius); }
  .vide { background: var(--paper-2); }
  .liste a:hover .titre { color: var(--accent-fonce); transform: translateX(6px); }
  @media (max-width: 800px) {
    .annee-bloc { grid-template-columns: 1fr; }
    .an { position: static; margin-bottom: 18px; font-size: 4.4rem; }
    .liste a { grid-template-columns: 1fr 88px; gap: 4px 16px; padding: 16px 0; }
    .date { grid-column: 1; grid-row: 1; }
    .titre { grid-column: 1; grid-row: 2; font-size: 1.1rem; }
    .liste img, .vide { grid-column: 2; grid-row: 1 / 3; width: 88px; }
  }
</style>
