---
import { photo, photoUrl } from '../lib/photo';
import Base from '../layouts/Base.astro';
import Metar from '../components/Metar.astro';
import { getCollection } from 'astro:content';
import club from '../data/club.json';
import pages from '../data/pages.json';
import t from '../data/tarifs.json';
import { url, asset, dateFr } from '../lib/utils';

const avions = (await getCollection('avions', (a) => a.data.actif)).sort((a, b) => a.data.ordre - b.data.ordre);
const annees = new Date().getFullYear() - 1979;
const pg = pages.accueil;
const slides = pg.diaporama.map((d) => ({ img: d.image, legende: d.legende }));
// Dernier mot (ou les deux derniers) en italique : c'est la signature typographique du style Horizon.
const italique = (txt: string, n = 1) => {
  const m = txt.trim().split(/\s+/);
  return { debut: m.slice(0, -n).join(' '), fin: m.slice(-n).join(' ') };
};
const h1 = italique(pg.titre);
const nf = (x: number) => x.toLocaleString('fr-FR');

// L'accueil est un sommaire : chaque rubrique du site y a un seul chapitre, qui renvoie vers sa page.
// Le détail (prix, simulateur, fiches avions) ne figure que sur la page concernée.
const prixMin = Math.min(...t.formules.flatMap((x) => x.prix.map((p) => p.prix)));
const HREFS = ['/decouvrir-le-vol', '/formations', '/club/flotte', '/club'];
const remplir = (txt: string) => txt
  .replace('{prix_bapteme}', nf(prixMin)).replace('{avions}', String(avions.length))
  .replace('{annees}', String(annees)).replace('{fondation}', club.fondation);
const chapitres = pg.chapitres.slice(0, 4).map((c, i) => ({
  rubrique: c.rubrique, titre: italique(c.titre, 2), texte: remplir(c.texte), fait: remplir(c.fait), lien: c.lien, href: HREFS[i], image: c.image,
}));
const jt = italique(pg.journal_titre);
const ft = italique(pg.fin_titre, 2);
const actus = (await getCollection('actualites', (a) => a.data.publie)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4);
---
<Base title="Accueil">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'SportsClub', name: club.nom, alternateName: club.sigle,
    url: new URL(url('/'), Astro.site).href, telephone: club.telephone, email: club.email, foundingDate: '1979',
    image: new URL(asset('/partage.jpg'), Astro.site).href, sameAs: [club.facebook],
    address: { '@type': 'PostalAddress', streetAddress: 'Aéroport de Beauvais-Tillé, zone aéroplaisance', postalCode: '60000', addressLocality: 'Tillé', addressCountry: 'FR' },
    geo: { '@type': 'GeoCoordinates', latitude: club.latitude, longitude: club.longitude },
  })} />

  <section class="hero" aria-label="Présentation">
    <div class="slides">
      {slides.map((sl, i) => <img {...photo(sl.img, '100vw')} fetchpriority={i ? undefined : 'high'} alt={sl.legende} class:list={{ on: i === 0 }} loading={i ? 'lazy' : 'eager'} />)}
      {pg.video && (
        <video class="h-video" autoplay muted loop playsinline preload="metadata" poster={photoUrl(slides[0]?.img)} aria-hidden="true">
          <source src={asset(pg.video)} type="video/mp4" />
        </video>
      )}
      {pg.video_mobile && (
        <video class="h-video h-video-mobile" muted loop playsinline preload="none" poster={asset(pg.video_mobile.replace(/\.mp4$/i, '.jpg'))} aria-hidden="true" data-src={asset(pg.video_mobile)}></video>
      )}
    </div>
    <div class="voile"></div>
    <div class="hero-metar"><Metar sombre /></div>
    <div class="hero-txt">
      <p class="hero-oaci">LFOB · Beauvais-Tillé · Depuis 1979</p>
      <h1 data-split="now">{h1.debut} <em>{h1.fin}</em></h1>
      <div class="hero-cote" data-reveal data-delay="0.8">
        <p>{pg.texte.replace('{annees}', String(annees))}</p>
        <a class="btn btn-clair" href={url('/contact?objet=Baptême')}>Réserver un baptême</a>
      </div>
    </div>
    {!pg.video && <p class:list={["hero-legende", { "sans-mobile": pg.video_mobile }]} id="slide-l">{slides[0]?.legende}</p>}
  </section>

  <section class="manif" aria-label={pg.atouts_titre}>
    <p class="manif-txt" data-split>{pg.atouts_titre}. <span>{remplir(pg.manifeste)}</span></p>
    <div class="chiffres" data-stagger>
      {pg.atouts.map((a) => {
        const v = a.chiffre.replace('{avions}', String(avions.length));
        const m = v.match(/^(\d+)\s*(%?)$/);
        return (
          <div>
            <strong {...(m ? { 'data-count': m[1], 'data-suffix': m[2] ? ' %' : undefined, 'data-from': +m[1] > 1000 ? String(+m[1] - 80) : undefined } : {})}>{v}</strong>
            <span>{a.texte}{a.lien && <> <a href={url(a.lien)}>{a.lien_texte || 'En savoir plus'}</a></>}</span>
          </div>
        );
      })}
    </div>
  </section>

  <section class="sommaire" aria-label="Sommaire du site">
    <div class="label">Au sommaire</div>
    {chapitres.map((c, i) => (
      <a class="chap" href={url(c.href)}>
        <div class="c-corps">
          <div class="c-txt">
            <p class="c-eti"><span>{c.rubrique}</span>{c.fait && <> · {c.fait}</>}</p>
            <h2 data-split>{c.titre.debut} <em>{c.titre.fin}</em></h2>
            <p>{c.texte}</p>
            <span class="c-lien">{c.lien}</span>
          </div>
          <div class="c-photo" data-clip><img {...photo(c.image, '(min-width: 900px) 50vw, 100vw')} alt="" loading="lazy" /></div>
        </div>
      </a>
    ))}
  </section>

  <section class="journal dark">
    <div class="j-tete">
      <div><div class="label">La vie du club</div><h2 data-split>{jt.debut} <em>{jt.fin}</em></h2></div>
      <a class="btn btn-outline" href={url('/actualites')}>Toutes les actualités</a>
    </div>
    <ol class="j-liste" data-stagger>
      {actus.map((a) => (
        <li><a href={url(`/actualites/${a.id}`)}><span class="j-date">{dateFr(a.data.date, { day: 'numeric', month: 'long', year: 'numeric' })}</span><span class="j-titre">{a.data.titre}</span></a></li>
      ))}
    </ol>
  </section>

  <section class="venir">
    <h2 data-split>{ft.debut} <em>{ft.fin}</em></h2>
    {pg.fin_texte && <p>{remplir(pg.fin_texte)}</p>}
    <div class="btns">
      <a class="btn btn-primary" href={url('/contact?objet=Baptême')}>Réserver un baptême</a>
      <a class="btn btn-outline" href={url('/contact')}>Nous contacter</a>
    </div>
  </section>
</Base>

<script>
  // Diaporama de la photo d'accueil (photos choisies dans le back-office)
  const imgs = [...document.querySelectorAll<HTMLImageElement>('.slides img')];
  const l = document.getElementById('slide-l');
  let i = 0;
  if (imgs.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => {
      imgs[i].classList.remove('on');
      i = (i + 1) % imgs.length;
      imgs[i].loading = 'eager';
      imgs[i].classList.add('on');
      if (l) l.textContent = imgs[i].alt;
    }, 7000);
  }

</script>


<script>
  // Vidéo de fond : coupée si le visiteur a demandé moins d'animations
  const v = document.querySelector<HTMLVideoElement>('.h-video');
  if (v && matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); }
  // Vidéo réservée au téléphone : chargée seulement sur petit écran, l'ordinateur garde les photos.
  const vm = document.querySelector<HTMLVideoElement>('.h-video-mobile');
  if (vm && matchMedia('(max-width: 760px)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    vm.src = vm.dataset.src || '';
    vm.play().catch(() => {});
  }
</script>

<style>
  .g { padding-inline: clamp(20px, 4vw, 56px); }
  /* Ouverture plein écran */
  .hero { position: relative; height: 100svh; min-height: 600px; color: #fff; background: var(--nuit); overflow: hidden; }
  .slides { position: absolute; inset: 0; }
  .h-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .h-video-mobile { display: none; }
  @media (max-width: 760px) { .h-video-mobile { display: block; } .hero-legende.sans-mobile { display: none; } }
  .slides img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; opacity: 0; transform: scale(1.08); transition: opacity 1.6s ease, transform 12s ease-out; }
  .slides img.on { opacity: 1; transform: scale(1); }
  .voile { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,14,.5) 0%, rgba(10,10,14,0) 28%, rgba(10,10,14,0) 48%, rgba(10,10,14,.72) 100%); }
  .hero-metar { position: absolute; z-index: 2; top: 84px; left: clamp(20px, 4vw, 56px); right: clamp(20px, 4vw, 56px); opacity: .9; }
  .hero-oaci { grid-column: 1 / -1; margin: 0 0 14px; font-family: var(--font-title); font-size: .78rem; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.85); }
  .hero-txt { position: absolute; z-index: 2; left: clamp(20px, 4vw, 56px); right: clamp(20px, 4vw, 56px); bottom: clamp(36px, 7vh, 72px); display: grid; grid-template-columns: 1fr auto; gap: 28px; align-items: end; }
  .hero h1 { color: #fff; font-size: clamp(3.2rem, 8.6vw, 8.4rem); line-height: .92; letter-spacing: -.05em; max-width: 11ch; margin: 0; }
  .hero h1 em { font-size: 1.06em; }
  .hero-cote { max-width: 330px; display: grid; gap: 18px; justify-items: start; }
  .hero-cote p { margin: 0; font-size: .98rem; color: rgba(255,255,255,.9); }
  .btn-clair { background: #fff; color: var(--ink); }
  .btn-clair:hover { background: var(--paper); color: var(--ink); }
  .hero-legende { position: absolute; z-index: 2; right: clamp(20px, 4vw, 56px); top: 84px; margin: 0; font-family: var(--font-title); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; opacity: .75; }

  /* Manifeste */
  .manif { padding: clamp(72px, 11vw, 160px) clamp(20px, 4vw, 56px) clamp(56px, 7vw, 96px); max-width: 1440px; margin: 0 auto; }
  .manif-txt { font-family: var(--font-title); font-weight: 300; font-size: clamp(1.9rem, 4.2vw, 4rem); line-height: 1.06; letter-spacing: -.035em; color: var(--ink); max-width: 21ch; margin: 0; }
  .manif-txt span { color: var(--muted); }
  .chiffres { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: clamp(48px, 7vw, 96px); border-top: 1px solid var(--line); }
  .chiffres > div { padding: 22px 24px 0 0; display: grid; gap: 8px; align-content: start; }
  .chiffres > div + div { padding-left: 24px; border-left: 1px solid var(--line); }
  .chiffres strong { font-family: var(--font-title); font-weight: 300; font-size: clamp(2.8rem, 5.4vw, 5rem); letter-spacing: -.045em; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
  .chiffres span { color: var(--muted); font-size: .92rem; max-width: 30ch; }

  /* Sommaire : un chapitre par rubrique, un filet, un numéro, une grande photo */
  .sommaire { max-width: 1440px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 56px) clamp(64px, 8vw, 120px); }
  .chap { display: block; padding: 22px 0 clamp(44px, 6vw, 88px); border-top: 1px solid var(--ink); color: inherit; text-decoration: none; }
  .c-eti { font-family: var(--font-title); font-size: .74rem; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin: 0 0 14px; }
  .c-eti span { color: var(--accent); }
  .c-corps { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(28px, 5vw, 88px); align-items: end; }
  .chap:nth-of-type(even) .c-txt { order: 2; }
  .chap h2 { font-size: clamp(2.4rem, 5.2vw, 5.2rem); margin: 0 0 .35em; max-width: 12ch; transition: color .3s; }
  .c-txt p { color: var(--muted); font-size: 1.08rem; max-width: 44ch; margin: 0 0 28px; }
  .c-lien { display: inline-flex; align-items: center; gap: .6em; min-height: 48px; padding: 0 24px; border-radius: 999px; border: 1px solid var(--ink); font-family: var(--font-title); font-weight: 500; font-size: .98rem; color: var(--ink); transition: background-color .25s, color .25s; }
  .c-lien::after { content: '→'; transition: transform .25s; }
  .chap:hover .c-lien { background: var(--ink); color: var(--paper); }
  .chap:hover .c-lien::after { transform: translateX(4px); }
  .c-photo { aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; }
  .c-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .chap:hover .c-photo img { transform: scale(1.04); }
  .chap:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }

  /* Dernières nouvelles, sur fond de nuit */
  .journal { background: var(--nuit); color: #c3cedf; padding: clamp(72px, 9vw, 130px) clamp(20px, 4vw, 56px); }
  .journal :global(.label) { color: #9a968c; }
  .j-tete { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(32px, 4vw, 56px); }
  .journal h2 { color: #eef3fb; margin: 0; }
  .j-liste { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(255,255,255,.16); }
  .j-liste a { display: grid; grid-template-columns: 13em 1fr; gap: 24px; align-items: baseline; padding: 20px 0; border-bottom: 1px solid rgba(255,255,255,.16); color: inherit; text-decoration: none; }
  .j-date { font-family: var(--font-title); font-size: .74rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: #8ea3c0; }
  .j-titre { font-family: var(--font-title); font-weight: 300; font-size: clamp(1.2rem, 2.2vw, 1.9rem); letter-spacing: -.03em; line-height: 1.15; color: #eef3fb; transition: color .2s, transform .4s cubic-bezier(.2,.7,.2,1); }
  .j-liste a:hover .j-titre { color: var(--sun-clair); transform: translateX(6px); }

  /* Fin de page */
  .venir { padding: clamp(80px, 11vw, 160px) clamp(20px, 4vw, 56px); text-align: center; display: grid; justify-items: center; gap: 8px; }
  .venir h2 { font-size: clamp(2.6rem, 7vw, 6.4rem); margin: 0 0 .15em; }
  .venir p { color: var(--muted); margin: 0 0 24px; }
  .venir .btns { justify-content: center; }

  @media (max-width: 900px) {
    .hero { max-height: none; }
    .hero-txt { grid-template-columns: 1fr; }
    .hero-legende { display: none; }
    .hero-metar { top: 76px; }
    .chiffres { grid-template-columns: 1fr; }
    .chiffres > div { grid-template-columns: auto 1fr; align-items: baseline; gap: 16px; padding: 18px 0; }
    .chiffres > div + div { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
    .chiffres strong { font-size: 2.6rem; white-space: nowrap; min-width: 2.4em; }
    .c-corps { grid-template-columns: 1fr; gap: 22px; align-items: start; }
    .c-photo, .chap:nth-of-type(even) .c-txt { order: 0; }
    .c-photo { order: -1 !important; }
    .j-liste a { grid-template-columns: 1fr; gap: 6px; padding: 16px 0; }
  }
  @media (max-width: 560px) {
    .venir .btns .btn { flex: 1 1 auto; justify-content: center; }
  }
</style>
