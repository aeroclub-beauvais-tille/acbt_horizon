---
// Tableau de bord TV du club (acbt60.fr/dashboard), protégé par mot de passe (middleware Cloudflare).
// Six écrans en alternance : Accueil, Flotte, Réservations, Météo, TEMSI/WINTEM, Radar et satellite. Données rafraîchies chaque minute.
import Dashboard from '../../layouts/Dashboard.astro';
import Logo from '../../components/Logo.astro';
import { getCollection } from 'astro:content';
const avions = await getCollection('avions', (a) => a.data.actif);
const modele = (t: string) => t.replace(/-\d+.*$| Petit Prince| Paris-Nice/g, '').trim().replace(/^Robin |^Jodel /, '');
const modeles = { 'F-BTBJ': 'DR315', ...Object.fromEntries(avions.map((a) => [a.data.immatriculation ?? a.data.nom, modele(a.data.type)])) };
---
<Dashboard title="Tableau de bord">
  <div id="scene" data-modeles={JSON.stringify(modeles)}>
    <header class="top">
      <div class="brand"><Logo class="lg" /><div><b>Aéroclub de Beauvais-Tillé</b><small>LFOB</small></div></div>
      <div class="alertes" id="alertes"></div>
      <div class="clock"><span class="h" data-h="local"></span><span class="cu"><span class="u"><span data-h="utc"></span> UTC</span><span class="d" data-h="date"></span></span></div>
    </header>

    <!-- 1. Accueil : soleil, messages du club, NOTAM -->
    <section class="ecran e1" data-e="0">
      <div class="panel" id="soleil"></div>
      <div class="r3">
        <div class="panel msg-p"><h2>Messages du club <span class="r" id="msg-info"></span></h2><div id="messages"></div></div>
        <div class="panel"><h2>NOTAM LFOB <span class="r" id="notam-info"></span></h2><div id="notam" class="nl"></div></div>
      </div>
    </section>

    <!-- 2. Flotte : potentiels et activité -->
    <section class="ecran ef" data-e="1">
      <div class="panel flotte">
        <h2>Flotte <span class="r">potentiel avant visite · vert &gt; 5 h · orange 2 à 5 h · rouge &lt; 2 h</span></h2>
        <div class="cartes" id="cartes"></div>
      </div>
      <div class="panel act-p"><h2>Activité des avions <span class="r">heures locales</span></h2><div id="activite"></div></div>
    </section>

    <!-- 2. Réservations -->
    <section class="ecran e2" data-e="2">
      <div class="panel"><h2>Planning du jour <span class="r" id="tl-info"></span></h2><div id="timeline"></div></div>
    </section>

    <!-- 3. Météo -->
    <section class="ecran e3" data-e="3">
      <div class="col">
        <div class="panel metar-p" id="metar"></div>
        <div class="panel maa-p"><h2>MAA LFOB <span class="r" id="maa-info"></span></h2><div id="maa"></div></div>
      </div>
      <div class="panel vent-p"><h2>Vent et pistes <span class="r" id="vent-info"></span></h2><div id="vent"></div></div>
      <div class="col">
        <div class="panel taf-p" id="taf"></div>
        <div class="panel vigi-p" hidden><h2>Vigilance Météo-France <span class="r">Oise et voisins</span></h2><div id="vigi"></div></div>
      </div>
    </section>

    <!-- 5. Cartes aéro : TEMSI, WINTEM, vents en altitude, METAR des terrains voisins -->
    <section class="ecran ec" data-e="4">
      <div class="panel carte-aero"><h2>TEMSI France <span class="r" id="temsi-h"></span></h2><div class="ca-img" id="temsi"></div></div>
      <div class="panel carte-aero"><h2>WINTEM <span class="r" id="wintem-h"></span></h2><div class="ca-img" id="wintem"></div></div>
      <div class="col">
        <div class="panel alt-p"><h2>Vents en altitude LFOB <span class="r">kt · prévision Météo-France</span></h2><div id="altitude"></div></div>
        <div class="panel voisins-p"><h2>METAR voisins <span class="r" id="voisins-h"></span></h2><div id="voisins"></div></div>
      </div>
    </section>

    <!-- 4. Radar et satellite -->
    <section class="ecran e4" data-e="5">
      <div class="panel img-p">
        <div class="img-t"><b>Satellite</b><span>visible le jour, infrarouge la nuit · EUMETSAT (MTG)</span><em id="sat-h"></em></div>
        <div class="carte" id="sat"></div>
        <div class="anim"><span>-2 h</span><div class="barre"><i id="sat-b"></i></div><span>maintenant</span></div>
      </div>
      <div class="panel img-p">
        <div class="img-t"><b>Pluie observée</b><span>radar des 2 dernières heures · RainViewer</span><em id="rad-h"></em></div>
        <div class="carte" id="rad"></div>
        <div class="anim"><span>-2 h</span><div class="barre"><i id="rad-b"></i></div><span>maintenant</span></div>
      </div>
      <div class="panel img-p" id="aro-p" hidden>
        <div class="img-t"><b>Prévision de pluie</b><span>prochaines heures · modèle AROME-PI de Météo-France</span><em id="aro-h"></em></div>
        <div class="carte" id="aro"></div>
        <div class="anim"><span>maintenant</span><div class="barre"><i id="aro-b"></i></div><span id="aro-fin"></span></div>
      </div>
    </section>

    <nav class="points" id="points" aria-label="Écrans">
      <button data-e="0" aria-label="Accueil"><i></i></button>
      <button data-e="1" aria-label="Flotte"><i></i></button>
      <button data-e="2" aria-label="Réservations"><i></i></button>
      <button data-e="3" aria-label="Météo"><i></i></button>
      <button data-e="4" aria-label="TEMSI et WINTEM"><i></i></button>
      <button data-e="5" aria-label="Radar et satellite"><i></i></button>
    </nav>
    <button type="button" class="pe-ecran" id="plein-ecran" aria-label="Plein écran" title="Plein écran">
      <svg class="ouvrir" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
      <svg class="fermer" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <footer class="foot"><span class="dot" id="etat"></span><span id="maj">Chargement…</span></footer>
  </div>
</Dashboard>

<style is:global>
  #scene { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; transform-origin: 0 0; padding: 22px 28px 44px; display: grid; grid-template-rows: auto 1fr; gap: 18px; }
  .top { display: flex; align-items: center; gap: 44px; height: 62px; }
  .brand { display: flex; align-items: center; gap: 16px; }
  .alertes { flex: 1; min-width: 0; display: flex; justify-content: center; gap: 12px; }
  .al { display: inline-flex; align-items: center; gap: 12px; min-width: 0; max-width: 100%; padding: 10px 22px; border-radius: 99px; font-size: 19px; font-weight: 700; color: var(--ink2); background: var(--panel); border: 1.5px solid var(--line); white-space: nowrap; overflow: hidden; }
  .al::before { content: ''; flex: none; width: 12px; height: 12px; border-radius: 50%; background: currentColor; }
  .al b { font-weight: 800; flex: none; } .al span { overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .al.a-ok { color: var(--ok); border-color: var(--ok); background: var(--okbg); } .al.a-ok span { color: var(--ink2); }
  .al.a-av { color: var(--warn); border-color: var(--warn); background: var(--warnbg); } .al.a-av span { color: var(--ink); }
  .al.a-on { color: var(--bad); border-color: var(--bad); background: var(--badbg); } .al.a-on span { color: var(--ink); }
  .al.a-on::before { animation: clignote 1.6s ease-in-out infinite; }
  @keyframes clignote { 50% { opacity: .25; } }
  .brand { --logo-h: 58px; --logo-rouge: #ec091d; color: var(--ink); }
  .brand b { font-size: 30px; font-weight: 800; display: block; line-height: 1.1; }
  .brand small { color: var(--muted); font-size: 17px; font-weight: 600; }
  .clock { margin-left: auto; display: flex; align-items: center; gap: 16px; }
  .clock .h { font-size: 56px; font-weight: 800; letter-spacing: -1px; line-height: 1; }
  .clock .cu { display: flex; flex-direction: column; gap: 2px; }
  .clock .u { font-family: var(--mono); font-size: 22px; color: var(--ink2); line-height: 1.1; }
  .clock .d { font-size: 15px; color: var(--muted); font-weight: 700; }
  .points { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; gap: 12px; }
  .points button { position: relative; width: 14px; height: 14px; padding: 0; border: 0; border-radius: 99px; background: var(--line); cursor: pointer; overflow: hidden; transition: width .3s; }
  .points button.on { width: 54px; }
  .points button i { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--yellow); }
  .points button.on i { width: calc(100% * var(--p, 1)); }
  .ecran { display: none; min-height: 0; gap: 18px; }
  .ecran.on { display: grid; }
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 18px 22px; min-height: 0; min-width: 0; overflow: hidden; }
  h2 { margin: 0 0 14px; font-size: 16px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); display: flex; align-items: center; gap: 10px; }
  h2 .r { margin-left: auto; text-transform: none; letter-spacing: 0; font-weight: 600; font-size: 15px; }
  .vide { color: var(--muted); font-size: 17px; font-weight: 600; padding: 8px 0; }
  .l { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .mono { font-family: var(--mono); }
  .pe-ecran { position: absolute; left: 22px; bottom: 4px; width: 30px; height: 30px; padding: 5px; border: 0; border-radius: 8px; background: transparent; color: var(--muted); opacity: .3; cursor: pointer; transition: opacity .2s, background .2s; }
  .pe-ecran:hover, .pe-ecran:focus-visible { opacity: 1; background: var(--panel); }
  .pe-ecran svg { width: 100%; height: 100%; display: block; } .pe-ecran .fermer { display: none; }
  :fullscreen .pe-ecran .ouvrir { display: none; } :fullscreen .pe-ecran .fermer { display: block; }
  .foot { position: absolute; right: 30px; bottom: 6px; font-size: 13px; color: var(--muted); font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--ok); display: inline-block; }
  .dot.ko { background: var(--bad); }
  #maj.alerte { color: var(--warn); font-size: 16px; font-weight: 800; }
  .pill { font-size: 14px; font-weight: 800; padding: 4px 11px; border-radius: 99px; white-space: nowrap; }
  .p-ok { background: var(--okbg); color: var(--ok); } .p-bad { background: var(--badbg); color: var(--bad); } .p-busy { background: rgba(143,166,255,.16); color: var(--accent); } .p-vol { background: rgba(64,201,127,.2); color: var(--ok); }

  /* 1. Accueil */
  .e1 { grid-template-rows: auto 1fr; }
  .e1 .r3 { display: grid; grid-template-columns: 1fr 1.7fr; gap: 18px; min-height: 0; }
  .e1 .r3 > .panel { display: flex; flex-direction: column; }
  .e1 .r3.sans-msg { grid-template-columns: 1fr; } .e1 .r3.sans-msg .msg-p { display: none; }
  /* Messages du club (publiés depuis l'espace membre par l'admin) */
  #messages { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 12px; overflow: hidden; }
  .mc { position: relative; border-radius: 12px; padding: 14px 18px 14px 20px; background: linear-gradient(90deg, rgba(143,166,255,.16), transparent 95%); overflow: hidden; }
  .mc::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background: var(--accent); }
  .mc.imp { background: linear-gradient(90deg, rgba(255,184,31,.22), transparent 95%); } .mc.imp::before { background: var(--yellow); }
  .mc b { display: block; font-size: 21px; font-weight: 800; line-height: 1.2; }
  .mc p { margin: 6px 0 0; font-size: 17px; font-weight: 600; line-height: 1.35; color: var(--ink2); }
  .mc small { display: block; margin-top: 8px; font-size: 13.5px; font-weight: 700; color: var(--muted); }
  /* 2. Flotte */
  .ef { grid-template-rows: auto 1fr; }
  .ef .act-p { display: flex; flex-direction: column; }
  .ef .cartes .av { padding: 16px 14px 14px; gap: 10px; }
  .ef .ring { width: 150px; height: 150px; } .ef .ring b { font-size: 32px; } .ef .ring small { font-size: 14px; }
  .ef .act .ar { max-height: 76px; grid-template-columns: 210px minmax(0, 1fr) minmax(0, 1fr); }
  .ef .act .im { font-size: 24px; } .ef .act .et { font-size: 13.5px; }
  .ef .act .ac b { font-size: 22px; } .ef .act .ac small { font-size: 15.5px; }
  /* 5. TEMSI / WINTEM */
  .ec { grid-template-columns: 1fr 1fr 520px; }
  .ec .col { display: flex; flex-direction: column; gap: 18px; min-height: 0; }
  .carte-aero { display: flex; flex-direction: column; }
  .ca-img { flex: 1; min-height: 0; border-radius: 12px; background: var(--panel2); display: grid; place-items: center; overflow: hidden; }
  .ca-img img { width: 100%; height: 100%; object-fit: contain; background: #fff; }
  .ca-vide { text-align: center; color: var(--muted); font-weight: 700; font-size: 17px; line-height: 1.5; padding: 30px; }
  .ca-vide svg { width: 64px; height: 64px; display: block; margin: 0 auto 14px; opacity: .5; }
  .ca-fl { display: flex; gap: 8px; margin-bottom: 10px; } .ca-fl span { font-family: var(--mono); font-weight: 700; font-size: 15px; padding: 3px 10px; border-radius: 7px; background: var(--panel2); color: var(--muted); } .ca-fl span.on { background: var(--accent); color: #fff; }
  .alt { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .alt th { font-size: 12.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); text-align: left; padding: 0 6px 6px; }
  .alt td { padding: 8px 6px; border-top: 1px solid var(--line); font-size: 17px; font-weight: 700; white-space: nowrap; }
  .alt td:first-child { font-family: var(--mono); color: var(--ink); font-size: 16px; }
  .alt .fl { display: inline-block; width: 18px; height: 18px; vertical-align: -3px; margin-right: 6px; color: var(--accent); }
  .alt .t { color: var(--muted); font-weight: 600; }
  .voisins-p { flex: 1; display: flex; flex-direction: column; }
  #voisins { flex: 1; min-height: 0; overflow: hidden; position: relative; }
  #voisins .def { animation: defile var(--duree, 60s) linear infinite; } #voisins .def > div { padding-bottom: 0 !important; }
  #voisins .mv { margin-bottom: 8px; }
  .mv { font-family: var(--mono); font-size: 14.5px; line-height: 1.35; color: var(--ink2); padding: 7px 10px 7px 12px; border-radius: 8px; background: var(--panel2); border-left: 4px solid var(--k, var(--muted)); }
  .mv b { color: var(--ink); } .mv .nm { font-family: var(--sans, inherit); font-weight: 700; color: var(--muted); font-size: 12.5px; margin-left: 6px; }
  #voisins-h { display: flex; gap: 14px; } .lgc { display: inline-flex; align-items: center; gap: 6px; } .lgc i { width: 10px; height: 10px; border-radius: 50%; background: var(--k); }
  .lgc.VFR, .mv.VFR { --k: var(--ok); } .lgc.MVFR { --k: var(--accent); } .lgc.IFR { --k: var(--bad); } .lgc.LIFR { --k: #c050ff; }
  .mv.VFR { --k: var(--ok); } .mv.MVFR { --k: var(--accent); } .mv.IFR { --k: var(--bad); } .mv.LIFR { --k: #c050ff; }
  .sf { position: relative; height: 40px; border-radius: 9px; overflow: hidden; background: var(--panel2); }
  .sf .seg { position: absolute; top: 0; bottom: 0; }
  .sf .civ { background: linear-gradient(90deg, var(--civ1), var(--civ2)); } .sf .civ2 { background: linear-gradient(90deg, var(--civ2), var(--civ1)); }
  .sf .day { background: linear-gradient(180deg, #5d8fe0, #3d6fc4); }
  .sf .ae { position: absolute; top: 3px; bottom: 3px; border: 2px solid var(--yellow); border-radius: 7px; }
  .sf .past { position: absolute; top: 0; bottom: 0; left: 0; background: var(--passe); }
  .sf .now { position: absolute; top: 0; bottom: 0; width: 3px; margin-left: -1px; background: var(--bad); border-radius: 2px; box-shadow: 0 0 0 2px rgba(0,0,0,.35); }
  .sf .nn { position: absolute; top: 0; bottom: 0; background: repeating-linear-gradient(135deg, rgba(143,166,255,.18) 0 6px, transparent 6px 12px); }
  .sfw { position: relative; padding-top: 24px; margin-top: -8px; }
  .sfw .nowl { position: absolute; top: 0; transform: translateX(-50%); background: var(--bad); color: #fff; font-family: var(--mono); font-size: 14px; font-weight: 700; padding: 1px 8px; border-radius: 6px; }
  .sx { position: relative; height: 18px; font-size: 13px; color: var(--muted); font-weight: 600; margin-top: 4px; }
  .sx i { position: absolute; transform: translateX(-50%); font-style: normal; }
  .sv { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-top: 8px; }
  .sv div { background: var(--panel2); border-radius: 10px; padding: 6px 12px; display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .sv small { display: block; font-size: 12px; color: var(--muted); font-weight: 800; text-transform: uppercase; letter-spacing: .5px; white-space: nowrap; }
  .sv b { font-size: 24px; font-weight: 800; }
  .sv .ae b { color: var(--yellow); } .sv .ac b { color: var(--accent); }
  .cdn { font-size: 16px; color: var(--muted); font-weight: 700; display: flex; align-items: baseline; gap: 10px; }
  .cdn b { font-size: 28px; color: var(--warn); font-weight: 800; }
  .lg2 { display: flex; gap: 18px; font-size: 13px; color: var(--muted); font-weight: 600; }
  .lg2 span { display: flex; gap: 6px; align-items: center; }
  .lg2 i { width: 16px; height: 10px; border-radius: 3px; display: inline-block; }
  .cartes { display: grid; gap: 14px; }
  .av { background: var(--panel2); border-radius: 14px; padding: 10px 14px 8px; min-width: 0; display: grid; grid-template-rows: auto auto auto auto; justify-items: center; gap: 6px; }
  .av.hs { background: var(--panel2) repeating-linear-gradient(135deg, transparent 0 12px, rgba(255,100,100,.16) 12px 14px); }
  .av-t { display: flex; flex-direction: column; align-items: center; max-width: 100%; line-height: 1.15; }
  .av-t b { font-family: var(--mono); font-size: 24px; white-space: nowrap; }
  .av-t small { color: var(--muted); font-weight: 600; font-size: 15px; white-space: nowrap; }
  .av .pill { font-size: 15px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
  .av-n:empty { display: none; }
  .av-n { height: 20px; font-size: 15px; font-weight: 700; color: var(--ink2); max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ring { position: relative; flex: none; width: 104px; height: 104px; }
  .ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .ring circle { fill: none; stroke-width: 4; stroke: var(--line); }
  .ring .arc { stroke: var(--ok); stroke-linecap: round; }
  .ring.warn .arc { stroke: var(--warn); } .ring.bad .arc { stroke: var(--bad); } .ring.off .arc { stroke: var(--muted); } .ring.off { opacity: .6; }
  .ring div { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  .ring b { font-weight: 800; line-height: 1; font-size: 22px; } .ring small { color: var(--muted); font-weight: 700; margin-top: 4px; font-size: 12px; }
  .ring.warn b { color: var(--warn); } .ring.bad b { color: var(--bad); }
  #activite { flex: 1; min-height: 0; }
  /* Activité des avions (variante B) : bloc plein à la couleur de l'état avec l'immat en blanc, le reste de la ligne sur fond neutre */
  .act { height: 100%; display: flex; flex-direction: column; gap: 6px; }
  .act .ar { flex: 1; min-height: 0; max-height: 64px; display: grid; grid-template-columns: 170px minmax(0, 1fr) minmax(0, 1fr); column-gap: 14px; align-items: stretch; }
  .act .ar:not(.th) { background: var(--panel2); border-radius: 12px; overflow: hidden; }
  .act .ar.th { flex: none; align-items: center; padding-bottom: 2px; }
  .act .ar.th span { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); padding-left: 14px; }
  .act .ai, .act .ac { min-width: 0; display: flex; flex-direction: column; justify-content: center; line-height: 1.1; }
  .act .ai { padding: 0 14px; background: var(--k); }
  .act .im { font-family: var(--mono); font-weight: 700; font-size: 19px; color: #fff; }
  .act .et { font-size: 11.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: rgba(255,255,255,.9); margin-top: 2px; }
  .act .k-l { --k: #1f9d57; } .act .k-r { --k: #3b5bdb; } .act .k-v { --k: #0f7a3d; } .act .k-m { --k: #d6333f; }
  .act .ac { padding: 0 8px; }
  .act .ac b { font-size: 18px; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .act .ac small { font-size: 13px; font-weight: 600; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
  .act .ac.vide b { color: var(--muted); font-weight: 600; }
  .nl .n { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 14px; padding: 11px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .nl .ic.l3 { font-size: 13px; letter-spacing: .3px; } .nl .ic.l4 { font-size: 11px; letter-spacing: .2px; }
  .nl .ic { width: 44px; height: 30px; border-radius: 7px; display: grid; place-items: center; font-weight: 900; font-size: 18px; color: #111; background: #f5c518; box-shadow: inset 0 0 0 2px #111, 0 0 0 1px #f5c518; letter-spacing: -.5px; }
  .nl .ic.rouge { background: #e0364f; color: #fff; box-shadow: inset 0 0 0 2px #fff3, 0 0 0 1px #e0364f; }
