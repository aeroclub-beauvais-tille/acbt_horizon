---
// Tableau de bord TV du club (acbt60.fr/dashboard), protégé par mot de passe (middleware Cloudflare).
// Quatre écrans en alternance : Accueil, Réservations, Météo, Radar et satellite. Données rafraîchies chaque minute.
import Dashboard from '../../layouts/Dashboard.astro';
import { getCollection } from 'astro:content';
const avions = await getCollection('avions', (a) => a.data.actif);
const modele = (t: string) => t.replace(/-\d+.*$| Petit Prince| Paris-Nice/g, '').trim().replace(/^Robin |^Jodel /, '');
const modeles = { 'F-BTBJ': 'DR315', ...Object.fromEntries(avions.map((a) => [a.data.immatriculation ?? a.data.nom, modele(a.data.type)])) };
---
<Dashboard title="Tableau de bord">
  <div id="scene" data-modeles={JSON.stringify(modeles)}>
    <header class="top">
      <div class="brand"><div class="lg">ACBT</div><div><b>Aéroclub Beauvais-Tillé</b><small>LFOB</small></div></div>
      <div class="clock"><span class="h" data-h="local"></span><span class="cu"><span class="u"><span data-h="utc"></span> UTC</span><span class="d" data-h="date"></span></span></div>
    </header>

    <!-- 1. Accueil -->
    <section class="ecran e1" data-e="0">
      <div class="panel" id="soleil"></div>
      <div class="panel flotte">
        <h2>Flotte <span class="r">potentiel avant visite · vert &gt; 5 h · orange 2 à 5 h · rouge &lt; 2 h</span></h2>
        <div class="cartes" id="cartes"></div>
      </div>
      <div class="r3">
        <div class="panel"><h2>Activité des avions <span class="r">heures locales</span></h2><div id="activite"></div></div>
        <div class="panel"><h2>NOTAM LFOB <span class="r" id="notam-info"></span></h2><div id="notam" class="nl"></div></div>
      </div>
    </section>

    <!-- 2. Réservations -->
    <section class="ecran e2" data-e="1">
      <div class="panel"><h2>Planning du jour <span class="r" id="tl-info"></span></h2><div id="timeline"></div></div>
    </section>

    <!-- 3. Météo -->
    <section class="ecran e3" data-e="2">
      <div class="col">
        <div class="panel metar-p" id="metar"></div>
        <div class="panel maa-p"><h2>MAA LFOB <span class="r" id="maa-info"></span></h2><div id="maa"></div></div>
      </div>
      <div class="panel vent-p"><h2>Vent et pistes <span class="r" id="vent-info"></span></h2><div id="vent"></div></div>
      <div class="panel" id="taf"></div>
    </section>

    <!-- 4. Radar et satellite -->
    <section class="ecran e4" data-e="3">
      <div class="panel img-p">
        <div class="img-t"><b>Satellite</b><span>visible le jour, infrarouge la nuit · EUMETSAT (MTG)</span><em id="sat-h"></em></div>
        <div class="carte" id="sat"></div>
        <div class="anim"><span>-2 h</span><div class="barre"><i id="sat-b"></i></div><span>maintenant</span></div>
      </div>
      <div class="panel img-p">
        <div class="img-t"><b>Pluie observée</b><span>radar des 2 dernières heures · RainViewer</span><em id="rad-h"></em></div>
        <div class="carte" id="rad"></div>
        <div class="anim"><span>-2 h</span><div class="barre"><i id="rad-b"></i></div><span>maintenant</span></div>
      </div>
      <div class="panel img-p" id="aro-p" hidden>
        <div class="img-t"><b>Prévision de pluie</b><span>jusqu’à +6 h · modèle AROME-PI de Météo-France</span><em id="aro-h"></em></div>
        <div class="carte" id="aro"></div>
        <div class="anim"><span>maintenant</span><div class="barre"><i id="aro-b"></i></div><span>+6 h</span></div>
      </div>
    </section>

    <nav class="points" id="points" aria-label="Écrans">
      <button data-e="0" aria-label="Accueil"><i></i></button>
      <button data-e="1" aria-label="Réservations"><i></i></button>
      <button data-e="2" aria-label="Météo"><i></i></button>
      <button data-e="3" aria-label="Radar et satellite"><i></i></button>
    </nav>
    <footer class="foot"><span class="dot" id="etat"></span><span id="maj">Chargement…</span></footer>
  </div>
</Dashboard>

<style is:global>
  #scene { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; transform-origin: 0 0; padding: 22px 28px 44px; display: grid; grid-template-rows: auto 1fr; gap: 18px; }
  .top { display: flex; align-items: center; gap: 44px; height: 62px; }
  .brand { display: flex; align-items: center; gap: 16px; }
  .brand .lg { width: 58px; height: 58px; border-radius: 12px; background: var(--navy); display: grid; place-items: center; font-weight: 800; font-size: 15px; color: #fff; }
  .brand b { font-size: 30px; font-weight: 800; display: block; line-height: 1.1; }
  .brand small { color: var(--muted); font-size: 17px; font-weight: 600; }
  .clock { margin-left: auto; display: flex; align-items: center; gap: 16px; }
  .clock .h { font-size: 56px; font-weight: 800; letter-spacing: -1px; line-height: 1; }
  .clock .cu { display: flex; flex-direction: column; gap: 2px; }
  .clock .u { font-family: var(--mono); font-size: 22px; color: var(--ink2); line-height: 1.1; }
  .clock .d { font-size: 15px; color: var(--muted); font-weight: 700; }
  .points { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; gap: 12px; }
  .points button { position: relative; width: 14px; height: 14px; padding: 0; border: 0; border-radius: 99px; background: var(--line); cursor: pointer; overflow: hidden; transition: width .3s; }
  .points button.on { width: 54px; }
  .points button i { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--yellow); }
  .points button.on i { width: calc(100% * var(--p, 1)); }
  .ecran { display: none; min-height: 0; gap: 18px; }
  .ecran.on { display: grid; }
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 18px 22px; min-height: 0; min-width: 0; overflow: hidden; }
  h2 { margin: 0 0 14px; font-size: 16px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); display: flex; align-items: center; gap: 10px; }
  h2 .r { margin-left: auto; text-transform: none; letter-spacing: 0; font-weight: 600; font-size: 15px; }
  .vide { color: var(--muted); font-size: 17px; font-weight: 600; padding: 8px 0; }
  .l { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .mono { font-family: var(--mono); }
  .foot { position: absolute; right: 30px; bottom: 6px; font-size: 13px; color: var(--muted); font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--ok); display: inline-block; }
  .dot.ko { background: var(--bad); }
  #maj.alerte { color: var(--warn); font-size: 16px; font-weight: 800; }
  .pill { font-size: 14px; font-weight: 800; padding: 4px 11px; border-radius: 99px; white-space: nowrap; }
  .p-ok { background: var(--okbg); color: var(--ok); } .p-bad { background: var(--badbg); color: var(--bad); } .p-busy { background: rgba(143,166,255,.16); color: var(--accent); }

  /* 1. Accueil */
  .e1 { grid-template-rows: auto auto 1fr; }
  .e1 .r3 { display: grid; grid-template-columns: 1.45fr 1fr; gap: 18px; min-height: 0; }
  .sf { position: relative; height: 40px; border-radius: 9px; overflow: hidden; background: var(--panel2); }
  .sf .seg { position: absolute; top: 0; bottom: 0; }
  .sf .civ { background: linear-gradient(90deg, var(--civ1), var(--civ2)); } .sf .civ2 { background: linear-gradient(90deg, var(--civ2), var(--civ1)); }
  .sf .day { background: linear-gradient(180deg, #5d8fe0, #3d6fc4); }
  .sf .ae { position: absolute; top: 3px; bottom: 3px; border: 2px solid var(--yellow); border-radius: 7px; }
  .sf .past { position: absolute; top: 0; bottom: 0; left: 0; background: var(--passe); }
  .sf .now { position: absolute; top: 0; bottom: 0; width: 3px; margin-left: -1px; background: var(--bad); border-radius: 2px; box-shadow: 0 0 0 2px rgba(0,0,0,.35); }
  .sf .nn { position: absolute; top: 0; bottom: 0; background: repeating-linear-gradient(135deg, rgba(143,166,255,.18) 0 6px, transparent 6px 12px); }
  .sfw { position: relative; padding-top: 24px; margin-top: -8px; }
  .sfw .nowl { position: absolute; top: 0; transform: translateX(-50%); background: var(--bad); color: #fff; font-family: var(--mono); font-size: 14px; font-weight: 700; padding: 1px 8px; border-radius: 6px; }
  .sx { position: relative; height: 18px; font-size: 13px; color: var(--muted); font-weight: 600; margin-top: 4px; }
  .sx i { position: absolute; transform: translateX(-50%); font-style: normal; }
  .sv { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-top: 8px; }
  .sv div { background: var(--panel2); border-radius: 10px; padding: 6px 12px; display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .sv small { display: block; font-size: 12px; color: var(--muted); font-weight: 800; text-transform: uppercase; letter-spacing: .5px; white-space: nowrap; }
  .sv b { font-size: 24px; font-weight: 800; }
  .sv .ae b { color: var(--yellow); } .sv .ac b { color: var(--accent); }
  .cdn { font-size: 16px; color: var(--muted); font-weight: 700; display: flex; align-items: baseline; gap: 10px; }
  .cdn b { font-size: 28px; color: var(--warn); font-weight: 800; }
  .lg2 { display: flex; gap: 18px; font-size: 13px; color: var(--muted); font-weight: 600; }
  .lg2 span { display: flex; gap: 6px; align-items: center; }
  .lg2 i { width: 16px; height: 10px; border-radius: 3px; display: inline-block; }
  .cartes { display: grid; gap: 14px; }
  .av { background: var(--panel2); border-radius: 14px; padding: 10px 14px 8px; min-width: 0; display: grid; grid-template-rows: auto auto auto auto; justify-items: center; gap: 6px; }
  .av.hs { background: var(--panel2) repeating-linear-gradient(135deg, transparent 0 12px, rgba(255,100,100,.16) 12px 14px); }
  .av-t { display: flex; flex-direction: column; align-items: center; max-width: 100%; line-height: 1.15; }
  .av-t b { font-family: var(--mono); font-size: 24px; white-space: nowrap; }
  .av-t small { color: var(--muted); font-weight: 600; font-size: 15px; white-space: nowrap; }
  .av .pill { font-size: 15px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
  .av-n:empty { display: none; }
  .av-n { height: 20px; font-size: 15px; font-weight: 700; color: var(--ink2); max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ring { position: relative; flex: none; width: 104px; height: 104px; }
  .ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .ring circle { fill: none; stroke-width: 4; stroke: var(--line); }
  .ring .arc { stroke: var(--ok); stroke-linecap: round; }
  .ring.warn .arc { stroke: var(--warn); } .ring.bad .arc { stroke: var(--bad); } .ring.off .arc { stroke: var(--muted); } .ring.off { opacity: .6; }
  .ring div { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  .ring b { font-weight: 800; line-height: 1; font-size: 22px; } .ring small { color: var(--muted); font-weight: 700; margin-top: 4px; font-size: 12px; }
  .ring.warn b { color: var(--warn); } .ring.bad b { color: var(--bad); }
  .e1 .r3 > .panel:first-child { display: flex; flex-direction: column; }
  #activite { flex: 1; min-height: 0; }
  .act { height: 100%; display: flex; flex-direction: column; gap: 4px; }
  .act .ar { flex: 1; min-height: 0; max-height: 64px; display: grid; grid-template-columns: 118px 150px minmax(0, 1.15fr) minmax(0, 1fr); column-gap: 16px; align-items: center; padding: 0 12px; border-radius: 10px; }
  .act .ar:nth-child(even) { background: var(--panel2); }
  .act .ar.th { flex: none; background: none; padding-bottom: 4px; }
  .act .ar.th span { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); }
  .act .ar > span { display: flex; align-items: center; gap: 10px; min-width: 0; white-space: nowrap; overflow: hidden; font-size: 18px; font-weight: 600; color: var(--ink2); }
  .act .im { font-family: var(--mono); font-weight: 700; font-size: 20px; color: var(--ink) !important; }
  .act b { font-weight: 800; color: var(--ink); flex: none; font-variant-numeric: tabular-nums; }
  .act i { font-style: normal; flex: none; font-size: 12.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--accent); background: rgba(143,166,255,.14); border-radius: 6px; padding: 2px 7px; }
  .act .mu { color: var(--muted); flex: none; }
  .act .nm2 { overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .act .pe { font-style: normal; font-size: 14px; font-weight: 800; padding: 4px 12px; border-radius: 99px; }
  .act .pe.g { color: var(--ok); background: var(--okbg); } .act .pe.a { color: var(--accent); background: rgba(143,166,255,.16); } .act .pe.r { color: var(--bad); background: var(--badbg); }
  .nl .n { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 14px; padding: 11px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .nl .ic.l3 { font-size: 13px; letter-spacing: .3px; } .nl .ic.l4 { font-size: 11px; letter-spacing: .2px; }
  .nl .ic { width: 44px; height: 30px; border-radius: 7px; display: grid; place-items: center; font-weight: 900; font-size: 18px; color: #111; background: #f5c518; box-shadow: inset 0 0 0 2px #111, 0 0 0 1px #f5c518; letter-spacing: -.5px; }
  .nl .ic.rouge { background: #e0364f; color: #fff; box-shadow: inset 0 0 0 2px #fff3, 0 0 0 1px #e0364f; }
  .nl .ic.bleu { background: #1e9bff; color: #fff; box-shadow: none; } .nl .ic.violet { background: #8b6cff; color: #fff; box-shadow: none; }
  .nl .ic.neige { background: #e8f6ff; color: #0b5fa5; box-shadow: inset 0 0 0 2px #0b5fa5; }
  .nl .ic.gris { background: var(--panel2); color: var(--ink2); box-shadow: inset 0 0 0 1.5px var(--muted); }
  .nl b em { font-style: normal; color: var(--bad); }
  .nl .actif { display: inline-block; font-size: 11.5px; font-weight: 900; letter-spacing: .6px; color: #fff; background: #23a55a; border-radius: 5px; padding: 1px 7px; margin-right: 8px; vertical-align: 1px; }
  .nl b .no { font-weight: 600; color: var(--muted); font-size: 14px; white-space: nowrap; }
  .nl .n:last-child { border-bottom: 0; }
  .nl b { font-size: 16.5px; font-weight: 700; display: block; }
  .e1 .r3 > .panel:last-child { display: flex; flex-direction: column; }
  #notam { flex: 1; min-height: 0; overflow: hidden; position: relative; -webkit-mask-image: linear-gradient(transparent, #000 18px, #000 calc(100% - 18px), transparent); mask-image: linear-gradient(transparent, #000 18px, #000 calc(100% - 18px), transparent); }
  #notam .def { animation: defile var(--duree, 60s) linear infinite; }
  @keyframes defile { from { transform: translateY(0); } to { transform: translateY(-50%); } }
  .nl small { display: block; color: var(--muted); font-size: 14px; font-weight: 600; margin-top: 3px; }

  /* 2. Réservations */
  .e2 { grid-template-columns: 1fr; }
  .e3 .col { display: flex; flex-direction: column; gap: 18px; min-height: 0; }
  .tl { display: grid; grid-template-columns: 170px 1fr; row-gap: 10px; align-items: center; }
  .hrs { grid-column: 2; position: relative; height: 22px; font-size: 16px; color: var(--muted); font-weight: 600; }
  .hrs i { position: absolute; transform: translateX(-50%); font-style: normal; }
  .lab b { font-family: var(--mono); font-size: 24px; font-weight: 700; display: block; }
  .lab small { display: block; color: var(--muted); font-size: 13px; font-weight: 600; }
  .lab.ins b { font-family: Manrope, sans-serif; font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .trk { position: relative; height: 84px; border-radius: 8px; background: var(--panel2); overflow: hidden; }
  .trk.ins { height: 48px; }
  .trk .g { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--line); }
  .trk .nuit { position: absolute; top: 0; bottom: 0; background: repeating-linear-gradient(135deg, rgba(143,166,255,.18) 0 6px, transparent 6px 12px); }
  .trk .passe { position: absolute; top: 0; bottom: 0; left: 0; background: rgba(0,0,0,.22); z-index: 2; pointer-events: none; }
  .rz { position: absolute; top: 7px; bottom: 7px; border-radius: 6px; color: #fff; font-size: 18px; font-weight: 700; padding: 6px 10px; white-space: nowrap; overflow: hidden; line-height: 1.2; z-index: 1; background: var(--r1); border-right: 2px solid var(--panel2); }
  .rz small { display: block; font-size: 14px; font-weight: 600; opacity: .9; }
  .rz.ins { background: var(--r2); } .rz.clu { background: var(--r3); }
  .rz.mnt { background: repeating-linear-gradient(45deg, #5b6a80 0 10px, #6d7c92 10px 20px); }
  .trk.ins .rz { top: 6px; bottom: 6px; padding: 7px 10px; font-size: 16px; }
  .trk.ins .rz small { display: none; }
  .trk.ins .rz.pres { background: rgba(64,201,127,.22); color: var(--ok); border: 1px solid rgba(64,201,127,.5); }
  .trk .now { position: absolute; top: 0; bottom: 0; width: 3px; background: var(--bad); z-index: 3; }
  .sep { grid-column: 1 / -1; height: 1px; background: var(--line); margin: 4px 0; }
  .leg { display: flex; gap: 22px; margin-top: 16px; font-size: 15px; color: var(--muted); font-weight: 600; }
  .leg span { display: flex; gap: 8px; align-items: center; }
  .leg i { width: 18px; height: 11px; border-radius: 3px; display: inline-block; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { background: var(--panel2); border-radius: 10px; padding: 7px 14px; font-size: 16px; font-weight: 800; color: var(--ink2); }
  .chip small { font-weight: 600; color: var(--muted); margin-left: 8px; font-size: 14px; }
  .chip.on { background: var(--okbg); color: var(--ok); } .chip.on small { color: var(--ok); }
  .chip.vol { background: rgba(143,166,255,.16); color: var(--accent); } .chip.vol small { color: var(--accent); }
  .res { display: grid; grid-template-columns: 150px 96px minmax(0, 1fr) 120px; gap: 12px; align-items: center; padding: 9px 8px; border-bottom: 1px solid var(--line); font-size: 17px; font-weight: 600; color: var(--ink2); }
  .res:last-child { border-bottom: 0; }
  .res .h { font-weight: 800; color: var(--ink); white-space: nowrap; }
  .res .im { font-family: var(--mono); font-weight: 700; font-size: 16px; }
  .res .ty { color: var(--muted); font-size: 15px; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .res.rp { opacity: .45; }
  .res.rn { background: rgba(143,166,255,.1); border-radius: 8px; }
  .res.rn .h { color: var(--accent); }

  /* 3. Météo */
  .e3 { grid-template-columns: 560px 1fr 640px; }
  .e3 .col { display: flex; flex-direction: column; gap: 18px; min-height: 0; }
  .metar-p { flex: 1; }
  .raw { font-family: var(--mono); font-size: 16px; line-height: 1.5; background: var(--panel2); border-radius: 10px; padding: 10px 14px; color: var(--ink2); word-break: break-word; }
  .fr { display: inline-flex; align-items: center; justify-content: center; min-width: 74px; font-weight: 800; font-size: 16px; padding: 4px 12px; border-radius: 99px; color: #111; background: #9aa3b5; letter-spacing: .5px; }
  .fr.VFR { background: #2fbf71; } .fr.MVFR { background: #f5c518; } .fr.IFR { background: #ff8a1f; } .fr.LIFR { background: #e0364f; color: #fff; }
  .fr.gd { font-size: 22px; padding: 6px 18px; min-width: 100px; }
  .mt-h { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; color: var(--muted); font-size: 15px; font-weight: 600; }
  .rows { margin-top: 10px; }
  .rows div { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 12px; padding: 9px 2px; border-bottom: 1px solid var(--line); font-size: 18px; }
  .rows div:last-child { border-bottom: 0; }
  .rows span { color: var(--muted); font-weight: 600; }
  .rows b { font-weight: 700; }
  .vent-p { display: flex; flex-direction: column; }
  #vent { flex: 1; min-height: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 14px; }
  .vd { display: flex; flex-direction: column; align-items: center; min-height: 0; }
  .vd .t { display: flex; align-items: baseline; gap: 22px; font-size: 48px; font-weight: 800; line-height: 1.05; }
  .vd .t small { font-size: 18px; font-weight: 700; color: var(--muted); } .vd .t small.raf { color: var(--warn); }
  .vd svg { flex: 1; min-height: 0; width: 100%; margin-top: 8px; }
  .qfus { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .qfu { display: grid; grid-template-columns: 50px 1fr; gap: 10px; align-items: center; background: var(--panel2); border: 1px solid transparent; border-radius: 12px; padding: 9px 14px; }
  .qfu .n { font-family: var(--mono); font-size: 24px; font-weight: 700; color: var(--muted); }
  .qfu b { font-size: 19px; font-weight: 800; display: block; } .qfu small { font-size: 14.5px; color: var(--muted); font-weight: 600; }
  .qfu.co { border-color: var(--ok); background: var(--okbg); } .qfu.co .n, .qfu.co b { color: var(--ok); }
  .qfu.arr b { color: var(--warn); }
  .per { display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; padding: 12px 14px; border-radius: 12px; border: 1px solid transparent; margin-top: 8px; border-left: 3px solid var(--line); }
  .per.on { border-color: var(--ok); background: var(--okbg); border-left-width: 3px; }
  .per .q b { font-size: 17px; font-weight: 800; } .per.on .q b { color: var(--ok); }
